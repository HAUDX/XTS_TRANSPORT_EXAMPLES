  <DUT Name="ST_PROCESS_CTRL" Id="{2683facd-a0f0-48fc-830a-5a5a3cf12da8}">
    <Declaration><![CDATA[TYPE ST_PROCESS_CTRL :
STRUCT
  Cmd               : E_PROCESS_CTRL;
  ProcessTarget     : UINT;
  ActivateStation   : WORD; // every bit is a XtsStation
  NestMask          : WORD; // every bit is a PosStop in a XtsStation, one mask for all XtsStations
END_STRUCT
END_TYPE
]]></Declaration>
