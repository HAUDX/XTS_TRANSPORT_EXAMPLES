      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 17;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station


      //---------------------------------------------------------
      nProcess                                        := 16;
      tProcess[nProcess]                              := T#2300MS;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 16;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 17;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 18;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 18;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      //---------------------------------------------------------
      nProcess                                        := 18;
      tProcess[nProcess]                              := T#2200MS;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 18;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 18;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 19;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 19;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      //---------------------------------------------------------
      nProcess                                        := 19;
      tProcess[nProcess]                              := T#500MS;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 19;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 19;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 1;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 1;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

    eInit                               := E_PROGRESS.PROGRESS_DONE;

END_CASE
]]></ST>
      </Implementation>
    </Action>
    <LineIds Name="MAIN_APP">
