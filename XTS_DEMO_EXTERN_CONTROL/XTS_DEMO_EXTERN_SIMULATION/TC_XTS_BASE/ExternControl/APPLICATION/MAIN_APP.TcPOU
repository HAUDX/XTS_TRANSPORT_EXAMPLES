      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 12;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 12;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 13;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 13;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      //---------------------------------------------------------
      nProcess                                        := 13;
      tProcess[nProcess]                              := T#500MS;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 13;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 13;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 14;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 15;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      //---------------------------------------------------------
