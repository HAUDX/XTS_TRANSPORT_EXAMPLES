      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 4;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 4;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      //---------------------------------------------------------
      nProcess                                        := 4;
      tProcess[nProcess]                              := T#500MS;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 4;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 4;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 5;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 5;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      //---------------------------------------------------------
      nProcess                                        := 5;
      tProcess[nProcess]                              := T#2200MS;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 5;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 5;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 6;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 6;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      //---------------------------------------------------------
      nProcess                                        := 6;
      tProcess[nProcess]                              := T#500MS;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 6;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 6;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 7;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 7;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      //---------------------------------------------------------
      nProcess                                        := 7;
