      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 7;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 7;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 8;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 8;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      //---------------------------------------------------------
      nProcess                                        := 8;
      tProcess[nProcess]                              := T#800MS;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 8;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 8;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 9;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 9;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      //---------------------------------------------------------
      nProcess                                        := 9;
      tProcess[nProcess]                              := T#2200MS;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 9;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 9;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 10;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 10;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      //---------------------------------------------------------
      nProcess                                        := 10;
      tProcess[nProcess]                              := T#500MS;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 10;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 10;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 11;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 11;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      //---------------------------------------------------------
      nProcess                                        := 11;
      tProcess[nProcess]                              := T#1900MS;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 11;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 11;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 12;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 12;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      //---------------------------------------------------------
      nProcess                                        := 12;
