STRUCT
  Init            : E_XPU_INIT;
  State           : E_XPU_STATE;
  Check           : E_XPU_CHECK;  // cyclic check result
  DcLink          : BIT;          // power all motor modules is ON
END_STRUCT
END_TYPE
]]></Declaration>
