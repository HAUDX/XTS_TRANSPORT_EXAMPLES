			<BaseType GUID="{18071995-0000-0000-0000-000000000009}">DINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[Standard]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[Mover 1 detection is off. There is no Mover 1 - with the special magnet plate - on the system.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Mover1]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[One Mover 1 - with the special magnet plate - is installed and will be detected as the first mover in the system.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[MultipleMover1]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[Multiple Mover 1 - with the special magnet plates - are installed and will be detected. Their ID is set to '1' and of the others '-' is used as ID.]]></Comment>
			</EnumInfo>
