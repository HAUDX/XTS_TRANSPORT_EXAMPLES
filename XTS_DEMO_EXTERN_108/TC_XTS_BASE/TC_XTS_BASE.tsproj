										<ContextId>1</ContextId>
									</Parameter>
									<Parameter OnlineParameter="true" ReadOnly="true" Group="Info">
										<Name>IsInfeed</Name>
										<Comment><![CDATA[Returns true if the module is an infeed. This works also for hygienic module where the infeed is solely determined by the infeed cable.]]></Comment>
