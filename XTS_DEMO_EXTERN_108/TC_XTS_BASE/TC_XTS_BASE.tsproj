									<Comment><![CDATA[Gets/Sets the XTS Task that is used for calculations for the XtsMover.]]></Comment>
									<BitSize>32</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-00000000000F}">OTCID</BaseType>
									<Default>
										<Value>#x00000000</Value>
									</Default>
