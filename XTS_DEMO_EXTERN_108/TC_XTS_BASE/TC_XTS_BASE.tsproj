									<Parameter OnlineParameter="true" CreateSymbol="true" ReadOnly="true" Group="EtherCAT Slave">
										<Name>IsInOp</Name>
										<Comment><![CDATA[Returns true when all EtherCAT slaves are in Op state.]]></Comment>
