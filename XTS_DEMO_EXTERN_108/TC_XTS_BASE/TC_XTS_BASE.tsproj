										<Comment><![CDATA[Returns true when communication to EtherCAT slave is interrupted.]]></Comment>
										<BitSize>8</BitSize>
										<BaseType GUID="{18071995-0000-0000-0000-000000000030}">BOOL</BaseType>
										<PTCID>#x030805c2</PTCID>
										<ContextId>1</ContextId>
									</Parameter>
									<Parameter HideParameter="true" Group="Assembly">
										<Name>PositionIndex</Name>
										<Comment><![CDATA[The index defines the position of the module in the XTS system. It ranges from zero to the count of modules minus one.]]></Comment>
										<BitSize>32</BitSize>
										<BaseType GUID="{18071995-0000-0000-0000-000000000008}">UDINT</BaseType>
										<PTCID>#x00000006</PTCID>
										<ContextId>1</ContextId>
									</Parameter>
									<Parameter Group="Assembly">
										<Name>Gap</Name>
										<Comment><![CDATA[Defines the gap between the previous module and this module.]]></Comment>
										<BitSize>64</BitSize>
										<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
										<Unit><![CDATA[mm]]></Unit>
										<PTCID>#x0308028b</PTCID>
										<ContextId>1</ContextId>
									</Parameter>
									<Parameter OnlineParameter="true" ReadOnly="true" Group="Info">
										<Name>IsInfeed</Name>
										<Comment><![CDATA[Returns true if the module is an infeed. This works also for hygienic module where the infeed is solely determined by the infeed cable.]]></Comment>
										<BitSize>8</BitSize>
										<BaseType GUID="{18071995-0000-0000-0000-000000000030}">BOOL</BaseType>
										<PTCID>#x0308033b</PTCID>
										<ContextId>1</ContextId>
									</Parameter>
									<Parameter OnlineParameter="true" HideParameter="true" ReadOnly="true" Group="Assembly">
										<Name>NetworkIndex</Name>
										<Comment><![CDATA[Returns a number indicating the network index which depends on master net id and drive address.]]></Comment>
										<BitSize>16</BitSize>
										<BaseType GUID="{18071995-0000-0000-0000-000000000005}">UINT</BaseType>
										<PTCID>#x03080346</PTCID>
										<ContextId>1</ContextId>
									</Parameter>
									<Parameter HideParameter="true" Group="Corrections">
										<Name>Offset</Name>
										<Comment><![CDATA[Define an offset for the module to compensate mechanical tolerances.]]></Comment>
										<BitSize>64</BitSize>
										<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
										<Unit><![CDATA[mm]]></Unit>
										<PTCID>#x00000007</PTCID>
										<ContextId>1</ContextId>
									</Parameter>
									<Parameter HideParameter="true" Group="Corrections">
										<Name>ScalingFactor</Name>
										<Comment><![CDATA[Define a ScalingFactor for the module to compensate mechanical tolerances.]]></Comment>
										<BitSize>64</BitSize>
										<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
										<Default>
											<Min>0.99</Min>
											<Max>1.01</Max>
											<Value>1.0</Value>
										</Default>
										<PTCID>#x00000008</PTCID>
										<ContextId>1</ContextId>
									</Parameter>
									<Parameter OnlineParameter="true" CreateSymbol="true" ReadOnly="true" Group="Diagnostics">
										<Name>HasActiveWarning</Name>
										<Comment><![CDATA[A warning indicator signals a potential issue when conditions exceed set thresholds.]]></Comment>
										<BitSize>8</BitSize>
										<BaseType GUID="{18071995-0000-0000-0000-000000000030}">BOOL</BaseType>
										<PTCID>#x03080608</PTCID>
										<ContextId>1</ContextId>
									</Parameter>
									<Parameter OnlineParameter="true" CreateSymbol="true" ReadOnly="true" Group="Diagnostics">
										<Name>ActiveWarning</Name>
										<BitSize>96</BitSize>
										<BaseType GUID="{B7EAFB63-8B80-4505-94F1-0779EF62100F}" Namespace="XTS">DiagnosticRecord</BaseType>
										<PTCID>#x03080609</PTCID>
										<ContextId>1</ContextId>
									</Parameter>
									<Parameter OnlineParameter="true" CreateSymbol="true" ReadOnly="true" Group="Diagnostics">
										<Name>HasActiveError</Name>
										<Comment><![CDATA[An error message is a notification that informs the user about a problem or malfunction.]]></Comment>
										<BitSize>8</BitSize>
										<BaseType GUID="{18071995-0000-0000-0000-000000000030}">BOOL</BaseType>
										<PTCID>#x0308060a</PTCID>
										<ContextId>1</ContextId>
									</Parameter>
