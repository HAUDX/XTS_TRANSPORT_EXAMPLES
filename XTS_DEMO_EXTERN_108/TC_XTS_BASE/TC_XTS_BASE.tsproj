			</EventId>
			<EventId>
				<Name Id="9111">DetectionAborted_NotEnoughMoversError</Name>
				<DisplayName TxtId=""><![CDATA[Detection is aborted because there are not enough movers available. Total available are {0} where {1} are already on included parts but {2} are configured to be detected.]]></DisplayName>
				<Severity>Verbose</Severity>
			</EventId>
			<EventId>
				<Name Id="9112">DetectionAborted_TooManyMoversError</Name>
