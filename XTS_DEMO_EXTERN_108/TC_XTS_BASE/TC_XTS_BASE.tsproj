				<Severity>Verbose</Severity>
			</EventId>
			<EventId>
				<Name Id="9109">PartBlock_InvalidStateChangeError</Name>
				<DisplayName TxtId=""><![CDATA[{0}: Can't change to state {1}. The state change activates connection of {2} to {3}, but {4} already has a active connection.]]></DisplayName>
				<Severity>Verbose</Severity>
			</EventId>
			<EventId>
				<Name Id="9110">TaskIsMissingError</Name>
