		<DataType>
			<Name GUID="{06715EC1-E512-4723-85B9-802151C8E1AE}" Namespace="XTS">PositionStartUpSimulationMode</Name>
			<BitSize>32</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000009}">DINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[UseOffsetAndDistance]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[Starting at the given offset the mover positions are generated with a fixed distance to each other.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[UseMoverParameters]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[The positions of the movers are set to the values defined by the simulation parameters of the mover objects.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[UseRandomDistribution]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[The positions of the movers are defined randomly - the specified mover distance is taken as the minimal distance between movers.]]></Comment>
			</EnumInfo>
			<Properties>
				<Property>
					<Name>plcAttribute_qualified_only</Name>
				</Property>
			</Properties>
			<Hides>
				<Hide GUID="{DCAB4133-D5E4-4F97-98F2-3925D7585836}"/>
			</Hides>
