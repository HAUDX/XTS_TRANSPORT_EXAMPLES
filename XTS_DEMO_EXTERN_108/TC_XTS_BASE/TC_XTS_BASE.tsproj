										<BaseType GUID="{18071995-0000-0000-0000-000000000005}">UINT</BaseType>
										<PTCID>#x00000085</PTCID>
										<ContextId>1</ContextId>
									</Parameter>
									<Parameter OnlineParameter="true" HideParameter="true" ReadOnly="true" Group="EtherCAT Slave">
										<Name>DriveConfigIdentity</Name>
										<Comment><![CDATA[Gets a structure of the configured Drive identity containing the vendor id, the code, the revision and the serial number.]]></Comment>
										<BitSize>128</BitSize>
										<BaseType GUID="{1EC63745-8DEE-41E3-A93D-CE6D14350001}" Namespace="XTS">ProductIdentity</BaseType>
