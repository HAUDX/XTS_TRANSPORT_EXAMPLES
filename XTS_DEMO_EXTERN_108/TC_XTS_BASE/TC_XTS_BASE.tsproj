										<BitSize>128</BitSize>
										<BaseType GUID="{1EC63745-8DEE-41E3-A93D-CE6D14350001}" Namespace="XTS">ProductIdentity</BaseType>
										<PTCID>#x00000065</PTCID>
										<ContextId>1</ContextId>
									</Parameter>
									<Parameter OnlineParameter="true" HideParameter="true" ReadOnly="true" Group="EtherCAT Slave">
										<Name>DriveEtherCatSlaveStateValue</Name>
										<Comment><![CDATA[Gets the state value of the IO drive terminal.]]></Comment>
