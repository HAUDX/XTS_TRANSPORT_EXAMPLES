										<Name>EncoderEtherCatSlaveStateText</Name>
										<Comment><![CDATA[Gets the state text of the IO encoder terminal.]]></Comment>
										<BitSize>256</BitSize>
										<BaseType GUID="{18071995-0000-0000-0000-00010000001F}">STRING(31)</BaseType>
										<PTCID>#x03080577</PTCID>
