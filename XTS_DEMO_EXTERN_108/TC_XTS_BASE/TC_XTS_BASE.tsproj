								</Parameter>
								<Parameter HideParameter="true" Group="Info">
									<Name>TaskOID</Name>
									<Comment><![CDATA[Gets/Sets the XTS Task that is used for calculations for the XtsMover.]]></Comment>
									<BitSize>32</BitSize>
