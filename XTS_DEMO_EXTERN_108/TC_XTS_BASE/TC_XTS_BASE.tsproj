									<BaseType GUID="{01E5C78E-D451-4377-9F02-F3812CC92C14}" Namespace="XTS">XtsMoverControllerOTCID</BaseType>
									<PTCID>#x0308050f</PTCID>
									<ContextId>1</ContextId>
								</Parameter>
								<Parameter Group="Mover Detection">
