			<EventId>
				<Name Id="9105">InvalidConnection_SwitchConfigContradictoryError</Name>
				<DisplayName TxtId=""><![CDATA[{0}: Configuration of switch with OTCID {1} in state {2} is contradictory. Two possible connections to {3} with link type {4} and {5} with link type {6}.]]></DisplayName>
				<Severity>Verbose</Severity>
			</EventId>
			<EventId>
				<Name Id="9106">CantActivateTrackWithPartBlockManagementError</Name>
