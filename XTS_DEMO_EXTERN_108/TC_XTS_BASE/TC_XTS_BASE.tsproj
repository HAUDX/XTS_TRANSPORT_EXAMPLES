										<BaseType GUID="{18071995-0000-0000-0000-00010000001F}">STRING(31)</BaseType>
										<PTCID>#x03080574</PTCID>
										<ContextId>1</ContextId>
									</Parameter>
									<Parameter OnlineParameter="true" ReadOnly="true" Group="EtherCAT Slave">
										<Name>DriveEtherCatSlaveStateInfo</Name>
