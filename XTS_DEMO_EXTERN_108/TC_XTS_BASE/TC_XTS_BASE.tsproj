										<BaseType GUID="{18071995-0000-0000-0000-000000000008}">UDINT</BaseType>
										<PTCID>#x03080605</PTCID>
										<ContextId>1</ContextId>
									</Parameter>
									<Parameter OnlineParameter="true" CreateSymbol="true" ReadOnly="true" Group="Drive CoE - Diag History">
										<Name>LatestMessages</Name>
