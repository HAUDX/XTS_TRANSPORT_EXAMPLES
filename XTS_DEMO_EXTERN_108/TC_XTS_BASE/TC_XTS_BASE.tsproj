				<Severity>Verbose</Severity>
			</EventId>
			<EventId>
				<Name Id="9107">InvalidConnection_InvalidAlwaysConnectionError</Name>
				<DisplayName TxtId=""><![CDATA[{0}: Can't add always connection to {1}. {2} already has a possible previous part. The connection should be always active, therefore a second connection is not possible.]]></DisplayName>
				<Severity>Verbose</Severity>
			</EventId>
			<EventId>
				<Name Id="9108">InvalidConnectionState_CantSetPrevOrNextError</Name>
