  GVL_XTS.StationParameter[nStationParameter].rVelo               :=   3000.0;
  GVL_XTS.StationParameter[nStationParameter].rAccDec             :=  rAccDefault;
  GVL_XTS.StationParameter[nStationParameter].rJerk               := 200000.0;
