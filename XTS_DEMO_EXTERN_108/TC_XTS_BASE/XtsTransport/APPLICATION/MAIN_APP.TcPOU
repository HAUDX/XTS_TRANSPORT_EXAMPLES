//  HAUD 2024.06.12
//
// 
//  - hard coded station parameter
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------

FOR nStationParameter := 1 TO MAX_STATION
DO
  GVL_XTS.StationParameter[nStationParameter].eType               := E_STATION_TYPE.STATION_PROCESS;
  GVL_XTS.StationParameter[nStationParameter].rVelo               :=   3000.0;
  GVL_XTS.StationParameter[nStationParameter].rAccDec             := rAccDefault;
  GVL_XTS.StationParameter[nStationParameter].rJerk               := 100000.0;
END_FOR 

//-----------------------------------------------------------------------------------------------------------------------------------------
//  INFEED
    sStationText  := TO_STRING(E_INSTANCE.INFEED);//'INFEED';
//-----------------------------------------------------------------------------------------------------------------------------------------
