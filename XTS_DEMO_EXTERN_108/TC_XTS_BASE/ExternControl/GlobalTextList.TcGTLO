            <o>
              <v n="TextID">"1246"</v>
              <v n="TextDefault">"0: 800/800/800
1: 600/800/800
2: 600/700/700
3: 700/800/800
4: 500/800/800"</v>
              <l n="LanguageTexts" t="ArrayList" />
            </o>
            <o>
              <v n="TextID">"605"</v>
              <v n="TextDefault">"0: fully loaded
2: mod 5 missing 1
