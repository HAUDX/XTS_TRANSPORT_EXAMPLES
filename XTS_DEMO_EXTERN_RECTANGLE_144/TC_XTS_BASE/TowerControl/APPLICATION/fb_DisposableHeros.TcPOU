    <Method Name="ListData" Id="{e0f3ecd8-3034-4b99-ab79-56c0741e0803}">
      <Declaration><![CDATA[METHOD ListData   : E_PROGRESS  // simulates data entry from transfersystem into BUFFER_INFEED linked list
VAR_INPUT
  Execute         : BOOL;
END_VAR
VAR_INST
  _nBit,
  _nExp           : BYTE;
  _nMod           : UINT := 5;

  _eStateProgress,
  _eRslt          : E_PROGRESS;

  _ProcessData    : ST_PROCESS_DATA;

  _nMinListCount  : UDINT := 1;
  _nWaitcountLast,
  _nWaitCount     : UDINT;

  _tMsg           : ST_Message;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
IF NOT Execute THEN _eStateProgress := E_PROGRESS.PROGRESS_INIT; END_IF
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eStateProgress
OF
   E_PROGRESS.PROGRESS_INIT:
    IF Execute
    THEN
      _eStateProgress         :=  E_PROGRESS.PROGRESS_BUSY;

      IF (_MessageLevel > E_MessageType.eMessageError)
      THEN
        _tMsg.eType           := E_MessageType.eMessageInfo;
        _tMsg.eSubdevice      := e_Subdevice.Application;
        _tMsg.iErrorNumber    := _nTicketCount;
        _tMsg.sText           := concat('ListData.TicketCount: ', TO_STRING(_nTicketCount));
        f_MessageSet(_tMsg);
      END_IF
    END_IF

  E_PROGRESS.PROGRESS_BUSY:
    CASE _nLoadCase
    OF
      0:  // fully loaded
        _eStateProgress       := E_PROGRESS.PROGRESS_CHECK;
        _nLoadCaseOld         := _nLoadCase;

        IF (_MessageLevel > E_MessageType.eMessageError)
        THEN
          _tMsg.eType         := E_MessageType.eMessageInfo;
          _tMsg.eSubdevice    := e_Subdevice.Application;
          _tMsg.iErrorNumber  := _nLoadCase;
          _tMsg.sText         := concat('ListData.Progress: ', TO_STRING(_eStateProgress));
          _tMsg.sText         := concat(_tMsg.sText, ': LoadCase: ');
          _tMsg.sText         := concat(_tMsg.sText, TO_STRING(_nLoadCase));
   
          f_MessageSet(_tMsg);
        END_IF


      1:  // static bits
        _eStateProgress       := E_PROGRESS.PROGRESS_PREPARE;
        _nLoadCaseOld         := _nLoadCase;

        IF (_MessageLevel > E_MessageType.eMessageError)
        THEN
          _tMsg.eType         := E_MessageType.eMessageInfo;
          _tMsg.eSubdevice    := e_Subdevice.Application;
          _tMsg.iErrorNumber  := _nLoadCase;
          _tMsg.sText         := concat('ListData.Progress: ', TO_STRING(_eStateProgress));
          _tMsg.sText         := concat(_tMsg.sText, ': LoadCase: ');
          _tMsg.sText         := concat(_tMsg.sText, TO_STRING(_nLoadCase));
          f_MessageSet(_tMsg);
        END_IF


      2:  // incrementing bits
        _eStateProgress       := E_PROGRESS.PROGRESS_STARTUP;
        _nLoadCaseOld         := _nLoadCase;

        IF (_MessageLevel > E_MessageType.eMessageError)
        THEN
          _tMsg.eType         := E_MessageType.eMessageInfo;
          _tMsg.eSubdevice    := e_Subdevice.Application;
          _tMsg.iErrorNumber  := _nLoadCase;
          _tMsg.sText         := concat('ListData.Progress: ', TO_STRING(_eStateProgress));
          _tMsg.sText         := concat(_tMsg.sText, ': LoadCase: ');
          _tMsg.sText         := concat(_tMsg.sText, TO_STRING(_nLoadCase));
          f_MessageSet(_tMsg);
        END_IF


      99:
        _eStateProgress       := E_PROGRESS.PROGRESS_WORKING;
        _ProcessData.wTarget  := 0;

        IF (_MessageLevel > E_MessageType.eMessageError)
        THEN
          _tMsg.eType          := E_MessageType.eMessageInfo;
          _tMsg.eSubdevice     := e_Subdevice.Application;
          _tMsg.iErrorNumber   := _nLoadCase;
          _tMsg.sText          := concat('sending empty ticket', ': _ProcessData.wTarget: ');
          _tMsg.sText          := concat(_stMsg.sText, f_BitsToString(_ProcessData.wTarget));
          f_MessageSet(_tMsg);
        END_IF
        _nLoadCase            := _nLoadCaseOld;

    ELSE
        _eStateProgress       := E_PROGRESS.PROGRESS_STARTUP;
    END_CASE
    _nWaitCount               := 0; 
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eStateProgress
OF
  E_PROGRESS.PROGRESS_PREPARE:
    _eStateProgress           := E_PROGRESS.PROGRESS_WORKING;
    _nExp                     := TO_BYTE(_nStationCount);
    _ProcessData.wTarget      := f_To_T_Process(_nExp);

    IF (_nTicketCount MOD _nMod = 0)
    THEN
      _nBit                   := SEL((_nBit>_nExp), _nBit+1, 0);
      _ProcessData.wTarget    := f_BitDel(_ProcessData.wTarget, _nBit);
    END_IF
    IF (_nTicketCount MOD (4) = 0)
    THEN
      _nBit                   := 1;
      _ProcessData.wTarget    := f_BitDel(_ProcessData.wTarget, _nBit);
    END_IF
    IF (_nTicketCount MOD (6) = 0)
    THEN
      _nBit                   := 2;
      _ProcessData.wTarget    := f_BitDel(_ProcessData.wTarget, _nBit);
    END_IF
    IF (_nTicketCount MOD (8) = 0)
    THEN
      _nBit                   := 3;
      _ProcessData.wTarget    := f_BitDel(_ProcessData.wTarget, _nBit);
    END_IF
    IF (_nTicketCount MOD (10) = 0)
    THEN
      _nBit                   := 4;
      _ProcessData.wTarget    := f_BitDel(_ProcessData.wTarget, _nBit);
    END_IF
    IF (_nTicketCount MOD (8) = 0)
    THEN
      _nBit                   := 5;
      _ProcessData.wTarget    := f_BitDel(_ProcessData.wTarget, _nBit);
    END_IF
    IF (_nTicketCount MOD (6) = 0)
    THEN
      _nBit                   := 6;
      _ProcessData.wTarget    := f_BitDel(_ProcessData.wTarget, _nBit);
    END_IF
    IF (_nTicketCount MOD (4) = 0)
    THEN
      _nBit                   := 7;
      _ProcessData.wTarget    := f_BitDel(_ProcessData.wTarget, _nBit);
    END_IF
    IF (_nTicketCount MOD (2) = 0)
    THEN
      _nBit                   := 8;
      _ProcessData.wTarget    := f_BitDel(_ProcessData.wTarget, _nBit);
    END_IF
    IF (_nTicketCount MOD (8) = 0)
    THEN
      _nBit                   := 9;
      _ProcessData.wTarget    := f_BitDel(_ProcessData.wTarget, _nBit);
    END_IF
    IF (_nTicketCount MOD (6) = 0)
    THEN
      _nBit                   := 10;
      _ProcessData.wTarget    := f_BitDel(_ProcessData.wTarget, _nBit);
    END_IF
    IF (_nTicketCount MOD (4) = 0)
    THEN
      _nBit                   := 11;
      _ProcessData.wTarget    := f_BitDel(_ProcessData.wTarget, _nBit);
    END_IF
    IF (_nTicketCount MOD (10) = 0)
    THEN
      _nBit                   := 12;
      _ProcessData.wTarget    := f_BitDel(_ProcessData.wTarget, _nBit);
    END_IF
    IF (_nTicketCount MOD (12) = 0)
    THEN
      _nBit                   := 13;
      _ProcessData.wTarget    := f_BitDel(_ProcessData.wTarget, _nBit);
    END_IF
    IF (_nTicketCount MOD (30) = 0)
    THEN
      _nBit                   := 14;
      _ProcessData.wTarget    := f_BitDel(_ProcessData.wTarget, _nBit);
    END_IF
    IF (_MessageLevel > E_MessageType.eMessageInfo)
    THEN
      _tMsg.eType             := E_MessageType.eMessageInfo;
      _tMsg.eSubdevice        := e_Subdevice.Application;
      _tMsg.iErrorNumber      := _nLoadCase;
      _tMsg.sText             := 'ListData.Progress: ';
      _tMsg.sText             := concat(_tMsg.sText, ': _ProcessData.wTarget: ');
      _tMsg.sText             := concat(_tMsg.sText, f_BitsToString(_ProcessData.wTarget));
      f_MessageSet(_tMsg);
    END_IF
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eStateProgress
OF
  E_PROGRESS.PROGRESS_STARTUP:
    _eStateProgress           := E_PROGRESS.PROGRESS_WORKING;
    _nExp                     := TO_BYTE(_nStationCount);
    _ProcessData.wTarget      := f_To_T_Process(_nExp);

    IF (_nTicketCount MOD _nMod = 0)
    THEN
      _nBit                   := SEL((_nBit>_nExp), _nBit+1, 0);
      _ProcessData.wTarget    := f_BitDel(_ProcessData.wTarget, _nBit);
    END_IF
    IF (_MessageLevel > E_MessageType.eMessageInfo)
    THEN
      _tMsg.eType             := E_MessageType.eMessageInfo;
      _tMsg.eSubdevice        := e_Subdevice.Application;
      _tMsg.iErrorNumber      := _nLoadCase;
      _tMsg.sText             := 'ListData.Progress: ';
      _tMsg.sText             := concat(_tMsg.sText, ': _ProcessData.wTarget: ');
      _tMsg.sText             := concat(_tMsg.sText, f_BitsToString(_ProcessData.wTarget));
      f_MessageSet(_tMsg);
    END_IF
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eStateProgress
OF
  E_PROGRESS.PROGRESS_CHECK:
    _eStateProgress           := E_PROGRESS.PROGRESS_WORKING;
    _nExp                     := TO_BYTE(_nStationCount);
    _ProcessData.wTarget      := f_To_T_Process(_nExp);

    IF (_MessageLevel > E_MessageType.eMessageinfo)
    THEN
      _tMsg.eType             := E_MessageType.eMessageInfo;
      _tMsg.eSubdevice        := e_Subdevice.Application;
      _tMsg.iErrorNumber      := _nLoadCase;
      _tMsg.sText             := 'ListData.Progress: ';
      _tMsg.sText             := concat(_tMsg.sText, ': _ProcessData.wTarget: ');
      _tMsg.sText             := concat(_tMsg.sText, f_BitsToString(_ProcessData.wTarget));
      f_MessageSet(_tMsg);
    END_IF
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eStateProgress
OF
  E_PROGRESS.PROGRESS_WORKING:
    _stProcessData.wTarget    := _ProcessData.wTarget;
    _wActivateStation         := _ProcessData.wTarget;
    _eStateProgress           :=  E_PROGRESS.PROGRESS_DONE;
    IF (_MessageLevel > E_MessageType.eMessageError)
    THEN
      _tMsg.eType             := E_MessageType.eMessageInfo;
      _tMsg.eSubdevice        := e_Subdevice.Application;
      _tMsg.iErrorNumber      := _nLoadCase;
      _tMsg.sText             := 'ListData.Progress: ';
      _tMsg.sText             := concat(_tMsg.sText, ': _wActivateStation: ');
      _tMsg.sText             := concat(_tMsg.sText, f_BitsToString(_ProcessData.wTarget));
      f_MessageSet(_tMsg);
    END_IF
END_CASE
//---------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------
CASE _eStateProgress
OF
  E_PROGRESS.PROGRESS_OCCUPIED:
    _eStateProgress           :=  E_PROGRESS.PROGRESS_DONE;
END_CASE

ListData                      := _eStateProgress;]]></ST>
      </Implementation>
    </Method>
