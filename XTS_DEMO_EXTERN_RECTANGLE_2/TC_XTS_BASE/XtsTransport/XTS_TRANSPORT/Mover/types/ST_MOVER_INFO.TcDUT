<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_MOVER_INFO" Id="{29ff1b39-ae85-4934-a1d9-2815bc42ac7a}">
    <Declaration><![CDATA[{attribute 'pack_mode' := '2'}
TYPE ST_MOVER_INFO :
STRUCT
  bMoverEnabled           : BIT;    // Axis[i].Status.ControlLoopClosed
  bMoverError             : BIT;    // Axis[i].Status.Error
  bMoverCoupled           : BIT;    // Axis[i].Status.Coupled OR _fbGearInPosCa[i].InSync
  bMoverStandstill        : BIT;    // Axis[i].Status.NotMoving
  bMoverAvoidingCollision : BIT;    // Axis[i].NcToPlc.StateDWord2.0
  bMoverInTarget          : BIT;    // Axis[i].NcToPlc.ActPos == rLastSetPos[i]

  rModuloActPos           : LREAL;  // Axis[i].NcToPlc.ModuloActPos
  rAbsActPos              : LREAL;  // Axis[i].NcToPlc.ActPos
  rAbsTargetPos           : LREAL;  // rLastSetPos[i]
  rModuloTargetPos        : LREAL;  // Tc2_Math.LMOD(_rLastSetPos[i], _RailLength)

  nErrorId                : UDINT;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>