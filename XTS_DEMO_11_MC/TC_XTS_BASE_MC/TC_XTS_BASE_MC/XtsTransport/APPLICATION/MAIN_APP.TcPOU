<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="MAIN_APP" Id="{a42cfa77-97a5-4ec9-b576-fd1e63c4d66c}" SpecialFunc="None">
    <Declaration><![CDATA[//---------------------------------------------------------------------------------------------------------------
//
//  HAUD 2026.10.25
//
//  - MAIN APPLICATION
//    - explicit simple example PRG for setting up application
//      - single stations; 
//        uses ST_STATION_CTRL/STATE
//      - global error handling; reset application from start
//
//  - intended to be deconstructed
//    - make this fit your way of doing things
//      - procedures in here show the datafields involved, so you may build around them
//
//  - Application checks:
//    - state of initialization of XtsTransport
//    - state of initialization of the transport related parts of the (your) application
//
//  - Application initializes:
//    - station parameters (hardcoded in this example)
//    - static station targets (1 to 1 in this example)
//
//  - Application controls:
//    - XtsTransport
//      - GVL_XTS.TransportCtrl
//      - GVL_XTS.TransportState
//
//    - Xts Stations
//      - GVL_XTS.StationCtrl[]
//      - GVL_XTS.StationState[]
//      - see MAIN.StationParameterInit for XtsStation parameters.
//        - Intention: for developing a transport layer, 
//                      the station parameters are part of the XTS, 
//                      the application primarily handles handshakes with XtsStations
//
//  - Application
//    - 5 single XtsStations
//      - automated handshakes 
//      - process with TON
//      - static targets
//
//---------------------------------------------------------------------------------------------------------------
// This SOFTWARE is provided as an Example by THE PROVIDER "as is" and "with all faults." THE PROVIDER makes no 
// representations or warranties of any kind concerning the safety, suitability, lack of viruses, inaccuracies, 
// typographical errors, or other harmful components of this SOFTWARE. There are inherent dangers in the use of 
// any software, and you are solely responsible for determining whether this SOFTWARE is compatible with your 
// equipment and other software installed on your equipment. You are also solely responsible for the protection 
// of your equipment and backup of your data, and THE PROVIDER will not be liable for any damages you may suffer 
// in connection with using, modifying, or distributing this SOFTWARE.
//---------------------------------------------------------------------------------------------------------------
PROGRAM MAIN_APP
VAR
  // init button
  eInit         : E_PROGRESS;
  // start button
  bStart        : BOOL;   // XtsTransport is initialized, CAGroup is built, All movers are enabled, XtsStations are cleared, XtsTransport base position for all movers is commanded, XtsStations are handshaked with timer
  // reset button
  bReset        : BOOL;   // All Xts Stations are cleared, requires new start

  // procedure steps
  nState        : UINT;   // state var for application

  // VISUALIZATION STRUCTURES
  stMainVis     : ST_MAIN_VIS;
  stVisMain     : ST_VIS_MAIN;


  tonProcess    : ARRAY[1..MAX_STATION] OF Tc2_Standard.TON;
  tProcess      : ARRAY[1..MAX_STATION] OF TIME;

  // work vars
  nStation      : UINT;
  nTarget       : ARRAY[1..MAX_STATION] OF UINT;  // contains target the station is sending the mover to, after process handshake was done

  JobResult     : E_PROGRESS;

  // example work vars
  eTransportState,
  eTransportStateOld    : E_XTS_TRANSPORT_STATE;

  eExecState            : E_XTS_TRANSPORT_STATE;
  eExecResult           : e_progress;
  stMsg                 : ST_Message;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//-----------------------------------------------------------------------------
// wait for initialization to be complete before work may start
//  - using something like this is recommended
//-----------------------------------------------------------------------------
IF NOT (MAIN_XTS.eInit = E_PROGRESS.PROGRESS_DONE)
THEN
  eInit                               := E_PROGRESS.PROGRESS_INVALID;

  stVisMain.Reset                     :=
  stVisMain.Start                     := FALSE;
  nState                              := 0;
  RETURN;
END_IF
//-----------------------------------------------------------------------------
// initialization for:
//  - setting a station config
//  - cross checking with the rest of your application
//-----------------------------------------------------------------------------
CASE eInit
OF
  E_PROGRESS.PROGRESS_INVALID:
    eInit                             := E_PROGRESS.PROGRESS_INIT;
    // most simple targeting
    // one after another
    FOR nStation := 1 TO MAX_STATION
    DO
      tProcess[nStation]              := T#650MS;
      nTarget [nStation]              := SEL(nStation<MAX_STATION, 1, nStation+1);
    END_FOR


  E_PROGRESS.PROGRESS_INIT:
    JobResult                         := StationParameterExample(); // this is the hardcoded example

    IF (JobResult = E_PROGRESS.PROGRESS_DONE)
    THEN
      eInit                           := E_PROGRESS.PROGRESS_BUSY;
    END_IF


  E_PROGRESS.PROGRESS_BUSY:
    // add inits for your application
    eInit                             := E_PROGRESS.PROGRESS_PREPARE;

  E_PROGRESS.PROGRESS_PREPARE:
    eInit                             := E_PROGRESS.PROGRESS_STARTUP;

  E_PROGRESS.PROGRESS_STARTUP:
    eInit                             := E_PROGRESS.PROGRESS_CHECK;

  E_PROGRESS.PROGRESS_CHECK:
    eInit                             := E_PROGRESS.PROGRESS_OCCUPIED;

  E_PROGRESS.PROGRESS_OCCUPIED:
    eInit                             := E_PROGRESS.PROGRESS_WORKING;

  E_PROGRESS.PROGRESS_WORKING:
    eInit                             := E_PROGRESS.PROGRESS_DONE;
    nState                            := 10;  // enable example state procedure

END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
//  example of how to connect to visualization structures
//-----------------------------------------------------------------------------
bReset                                := stVisMain.Reset;
bStart                                := stVisMain.Start;

IF stVisMain.Init
THEN
  stVisMain.Init                      := FALSE;
  eInit                               := E_PROGRESS.PROGRESS_INVALID;
END_IF

stMainVis.eInitApplication            := eInit;
stMainVis.sInitApplication            := TO_STRING(eInit);

stMainVis.eInitXts                    := MAIN_XTS.eInit;
stMainVis.sInitXts                    := TO_STRING(MAIN_XTS.eInit);

stMainVis.nStateApplication           := nState;
//-----------------------------------------------------------------------------
// in case eInit is not done --> return 
//-----------------------------------------------------------------------------
IF NOT (eInit = E_PROGRESS.PROGRESS_DONE)
THEN
  RETURN; // you decide if this fits your application
END_IF
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
// fetch hard reset          --> jump to state
//                               you decide if it fits your application
//-----------------------------------------------------------------------------
IF bReset
THEN
  bReset                              := FALSE;
  bStart                              := FALSE;
  nState                              := 9000;  // jump state
END_IF
//-----------------------------------------------------------------------------
// basic example procedures to startup the XTS_TRANSPORT_LAYER
//  - this is only for showing thw basic handshake mechanics 
//  - this not a production ready state machine 
//-----------------------------------------------------------------------------
CASE nState 
OF
  10:                                 // check start button
    IF bStart
    THEN
      nState                          := 100; // let's go
    END_IF

  //--------------------------------------------------------------------------------------------
  // ST_TRANSPORT_CTRL / ST_TRANSPORT_STATE - handshake procedures
  //--------------------------------------------------------------------------------------------
  100:                                // - clear general command interface
                                      // - check XpuInfo
                                      // - clear collision avoidance group: 
                                      //    --> error free mover and group
                                      // - add all movers to collision avoidance group:
                                      //    --> error free group with movers
                                      // - enable collision avoidance group:
                                      //    --> group enabled in error free state
                                      // - enable movers:
                                      //    --> control loop closed and error free
                                      // - start transport system:
                                      //    --> move all movers to start station
                                      //    --> add all mover tickets to start station linked list

    GVL_XTS.XtsTransportCtrl.Cmd      := E_XTS_TRANSPORT_CTRL.CMD_NULL;
    nState                            := 110;

  110:                                // double check initialization of XtsTransport, wait for either MoverDetection being valid or OperationMode.Simulation
    IF (GVL_XTS.XtsTransportState.XpuInfo.IdDetectionValid) OR
       (GVL_XTS.XtsTransportState.XpuInfo.OperationMode = OperationMode.Simulation)
    THEN
      // now XtsTransport is initialized, cyclic plausibility checks on Xpu are active
      nState                          := 120;
    END_IF

  120:                                // clear group for defined start situation
    GVL_XTS.XtsTransportCtrl.Cmd      := E_XTS_TRANSPORT_CTRL.CMD_GROUP_CLEAR;

    IF (GVL_XTS.XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_GROUP_CLEAR + E_PROGRESS.PROGRESS_ERROR)
    THEN
      nState                          := 9120;

    ELSIF (GVL_XTS.XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_GROUP_CLEAR + E_PROGRESS.PROGRESS_DONE)
    THEN
      // CA Group is now in defined error free state
      nState                          := 130;
    END_IF

  130:                                // build Collision Avoidance group with all movers
    GVL_XTS.XtsTransportCtrl.Cmd      := E_XTS_TRANSPORT_CTRL.CMD_GROUP_BUILD;

    IF (GVL_XTS.XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_GROUP_BUILD + E_PROGRESS.PROGRESS_ERROR)
    THEN
      nState                          := 9044;

    ELSIF (GVL_XTS.XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_GROUP_BUILD + E_PROGRESS.PROGRESS_DONE)
    THEN
      // CA Group contains all movers now
      // GVL_XTS.XtsTransportState.GroupInfo.AxisCount = MAX_MOVER
      nState                          := 140;
    END_IF

  140:                                // enable CA Group
    GVL_XTS.XtsTransportCtrl.Cmd      := E_XTS_TRANSPORT_CTRL.CMD_GROUP_ENABLE;

    IF (GVL_XTS.XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_GROUP_ENABLE + E_PROGRESS.PROGRESS_ERROR)
    THEN
      nState                          := 9011;

    ELSIF (GVL_XTS.XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_GROUP_ENABLE + E_PROGRESS.PROGRESS_DONE)
    THEN
      // GVL_XTS.XtsTransportState.GroupInfo.CaGroupState = mcGroupStateNotReady
      nState                          := 150;
    END_IF

  150:                                // enable all movers
    GVL_XTS.XtsTransportCtrl.Cmd      := E_XTS_TRANSPORT_CTRL.CMD_MOVER_ENABLE;

    IF (GVL_XTS.XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_MOVER_ENABLE + E_PROGRESS.PROGRESS_ERROR)
    THEN
      nState                          := 9011;

    ELSIF (GVL_XTS.XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_MOVER_ENABLE + E_PROGRESS.PROGRESS_DONE)
    THEN
      // GVL_XTS.XtsTransportState.GroupInfo.CaGroupState = mcGroupStateStandby
      nState                          := 160;
    END_IF

  160:                                // command all movers to startup position
    GVL_XTS.XtsTransportCtrl.Cmd      := E_XTS_TRANSPORT_CTRL.CMD_TRANSPORT_START;

    IF (GVL_XTS.XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_START + E_PROGRESS.PROGRESS_DONE)
    THEN
      // all XtsStations are cleared
      // all movers are now waiting at GVL_XTS.XtsTransport.StartStationIndex
      // all movers are entered into GVL_XTS.StationList[GVL_XTS.XtsTransport.StartStationIndex]._stList 
      nState                          := 170;
    END_IF

  170:
    nState                            := 1000;

  //--------------------------------------------------------------------------------------------
  // ST_STATION_CTRL / ST_STATION_STATE - handshake example
  //--------------------------------------------------------------------------------------------
  1000:                                 // automatic handshakes with XtsStations
                                        //  this is the example for handshakes
                                        // deconstruct this part and 
                                        //  plug the station(s) into other parts of your software
    FOR nStation := 1 TO MAX_STATION
    DO
      CASE GVL_XTS.StationState[nStation].State
      OF
        //-------------------------------------------------------------------------------------
        E_STATION_STATE.STATION_DISABLE:          // switch on XtsStation
          GVL_XTS.StationCtrl[nStation].Cmd     := E_STATION_CTRL.STATION_ENABLE;

        //-------------------------------------------------------------------------------------
        E_STATION_STATE.STATION_MOVER_ENTER:      // let mover enter
          // mover was detected in list and station is asking for mover entry
          IF (tProcess[nStation] < T#10MS)
          THEN
            // this is an example! make the decision whether to work or not in your world, then fire the command you have chosen.
            GVL_XTS.StationCtrl[nStation].Cmd   := E_STATION_CTRL.STATION_MOVER_SEND;     // no process handshake, direct state change to MOVER_OUT
          ELSE 
            GVL_XTS.StationCtrl[nStation].Cmd   := E_STATION_CTRL.STATION_MOVER_ENTER;    // allow entry
          END_IF

        //-------------------------------------------------------------------------------------
        E_STATION_STATE.STATION_PROCESS_START:    // first process handshake, clear timer
          // mover has arrived and is in standstill, ready for process 
          tonProcess[nStation](
                              IN                :=FALSE, 
                              PT                :=tProcess[nStation]);
          GVL_XTS.StationCtrl[nStation].Cmd     := E_STATION_CTRL.STATION_PROCESS_START;  // regular 'double' handshake for you to organise your process procedure

//          GVL_XTS.StationCtrl[nStation].Cmd     := E_STATION_CTRL.STATION_PROCESS_DONE;   // regular 'single' handshake for you to organise your process procedure
//          GVL_XTS.StationCtrl[nStation].Cmd     := E_STATION_CTRL.STATION_MOVER_OUT;      // the shortest straw has been pulled for you - if you trigger this you MUST be sure that your target data is valid


        //-------------------------------------------------------------------------------------
        E_STATION_STATE.STATION_PROCESS_DONE:     // second process handshake, timer runs now
          tonProcess[nStation](
                              IN                :=TRUE, 
                              PT                :=tProcess[nStation]);
          IF tonProcess[nStation].Q
          THEN
            GVL_XTS.StationCtrl[nStation].nTargetStation  := TO_USINT(nTarget[nStation]); // static in this example
            GVL_XTS.StationCtrl[nStation].nMask := 2#1; // bitmask for mover ticket to next XtsStation; if you use more than one StopPos[] in XtsStation

//            GVL_XTS.StationCtrl[nStation].Cmd    := E_STATION_CTRL.STATION_PROCESS_DONE; // regulear 'double' handshake

            GVL_XTS.StationCtrl[nStation].Cmd   := E_STATION_CTRL.STATION_MOVER_OUT;     // the shortest straw has been pulled for you - if you trigger this you MUST be sure that your target data is valid
          END_IF

        //-------------------------------------------------------------------------------------
        E_STATION_STATE.STATION_CHECK_NEST:        // station wants to work next nest
        // this state is set by the station.
        // for a detailed flowchart see:
        //   XTS_TRANSPORT_LAYER/DOCUMENTATION/Documents/Stations
        //    GVL_XTS.StationExample_*.pdf
        //
        // the station examines the nMask bitmask
        // the sending station decides how many nests are to be worked on the mover
        //  - GVL_XTS.StationCtrl[nStation].nMask := 2#1;


        //-------------------------------------------------------------------------------------
        E_STATION_STATE.STATION_MOVER_OUT:        // station wants to send out mover
          // when sending out mover, the data on Ctrl struct is absolute important
          // before allowing the outfeed of the mover, the data on Ctrl struct must be entered correctly
          // Ctrl.nTargetStation allows for flexible mover transport, this is fully depending on you to make sense aside this example

          GVL_XTS.StationCtrl[nStation].nTargetStation  := TO_USINT(nTarget[nStation]); // static in this example
          GVL_XTS.StationCtrl[nStation].nMask   := 2#1; // bitmask for mover ticket to next XtsStation; if you use more than one StopPos[] in XtsStation

          GVL_XTS.StationCtrl[nStation].Cmd     := E_STATION_CTRL.STATION_MOVER_OUT;  // allow outfeed of mover

        //-------------------------------------------------------------------------------------
        E_STATION_STATE.STATION_MOVER_GONE:       // mover has travelled ReleaseDistance, XtsStation is now empty and ready for the next mover in queue
          GVL_XTS.StationCtrl[nStation].nTargetStation  := 0;                           // clear target after mover left the station
          GVL_XTS.StationCtrl[nStation].Cmd     := E_STATION_CTRL.STATION_MOVER_GONE; // last handshake for empty station
      END_CASE
    END_FOR


  //--------------------------------------------------------------------------------------------
  // ST_TRANSPORT_CTRL / ST_TRANSPORT_STATE - handshake procedures
  //--------------------------------------------------------------------------------------------
  9000:                                     // example procedure for 
                                            // - halting transport 
                                            // - clearing stations

    GVL_XTS.XtsTransportCtrl.Cmd      := E_XTS_TRANSPORT_CTRL.CMD_NULL;
    nState                            := 9010;

  9010:                               // halt all movers and clear group
    GVL_XTS.XtsTransportCtrl.Cmd      := E_XTS_TRANSPORT_CTRL.CMD_GROUP_CLEAR;

    IF (GVL_XTS.XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_GROUP_CLEAR + E_PROGRESS.PROGRESS_ERROR)
    THEN
      nState                          := 9000;

    ELSIF (GVL_XTS.XtsTransportState.State = E_XTS_TRANSPORT_STATE.TRANSPORT_GROUP_CLEAR + E_PROGRESS.PROGRESS_DONE)
    THEN
      // CA group cleared and mover in standstill
      nState                          := 9100;
    END_IF

  9100:                               // switch off movers
    GVL_XTS.XtsTransportCtrl.Cmd      := E_XTS_TRANSPORT_CTRL.CMD_MOVER_DISABLE;

    IF (GVL_XTS.XtsTransportState.State >= E_XTS_TRANSPORT_STATE.TRANSPORT_MOVER_DISABLE + E_PROGRESS.PROGRESS_ERROR)
    THEN
      nState                          := 9200;
    END_IF

  9200:                               // clear All XtsStations
    nState                            := 9300;
    FOR nStation := 1 TO MAX_STATION
    DO
       GVL_XTS.StationCtrl[nStation].Cmd      := E_STATION_CTRL.STATION_INIT;
    END_FOR

  9300:                               // disable All XtsStations
    nState                            := 9400;   // go back to start
    FOR nStation := 1 TO MAX_STATION
    DO
       GVL_XTS.StationCtrl[nStation].Cmd      := E_STATION_CTRL.STATION_DISABLE;
    END_FOR

  9400:
    nState                            := 10;
END_CASE


]]></ST>
    </Implementation>
