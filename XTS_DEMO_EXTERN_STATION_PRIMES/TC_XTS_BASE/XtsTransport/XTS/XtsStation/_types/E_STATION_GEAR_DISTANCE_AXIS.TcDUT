  <DUT Name="E_STATION_GEAR_DISTANCE_AXIS" Id="{80b9a8a0-a46d-4de9-a25d-2b82fa56aa9d}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_STATION_GEAR_DISTANCE_AXIS :
(
  // which axis nSync distance is checked for termination of GearInPosCA.
  // after nSync distance the station does a regular outfeed to target station
	FOLLOW_THE_MASTER,
  FOLLOW_THE_SLAVE
)UINT;
END_TYPE
]]></Declaration>
  </DUT>
