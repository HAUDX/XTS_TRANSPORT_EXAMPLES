<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_PROCESS_CTRL" Id="{c0cf605f-372a-4ebd-85b7-489679c9963c}">
    <Declaration><![CDATA[{attribute 'pack_mode' := '2'}
TYPE ST_PROCESS_CTRL :
STRUCT
  Cmd               : E_PROCESS_CTRL;
  ProcessTarget     : UINT;
  ActivateStation   : T_PROCESS;  // every bit is a XtsStation
  NestMask          : BYTE;       // every bit is a PosStop in a XtsStation, one mask for all XtsStations, copied to every XtsStation control in process
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>