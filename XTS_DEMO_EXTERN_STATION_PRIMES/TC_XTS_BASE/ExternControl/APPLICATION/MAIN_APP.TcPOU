<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN_APP" Id="{aed82ec5-7c0f-4ed8-9d95-00008ab7747f}" SpecialFunc="None">
    <Declaration><![CDATA[//---------------------------------------------------------------------------------------------------------------
//
//  HAUD 2026.10.25
//
//  - ExternControl
//
//    - this is the main switchboard
//
//    - Transport abstractions are called here:
//    --------------------------------------------
//    - top level transport abstractions
//      - Instances contain the required transport logic
//      - Instances control their assigned ProcessCollector
//      - Instances are controlled in timer based application
//
//    - mid level transport abstractions
//      - StationCollectors and by extension ProcessCollectors
//      - Collectors are for gathering states and routing commands to ST_STATION_CTRL/STATE
//      - Collectors are configured during startup
//
//---------------------------------------------------------------------------------------------------------------
PROGRAM MAIN_APP
VAR
  eInitXtsTransport   AT %I*    : E_PROGRESS;   // initialization from XtsTransport PLC
  eInit               AT %Q*    : E_PROGRESS;   // local startup transmitted to TowerControl

  idx                           : UINT;
  nProcess                      : E_INSTANCE;
  {attribute 'displaymode':='bin'}
  TargetMask                    : ARRAY[1..MAX_PROCESS] OF ARRAY[1..SIZEOF(T_PROCESS)*8] OF BYTE;

  // message pipeline(s) handling
  eMtrState,
  eMsgState                     : E_MESSAGE_STATE;
  eMtrProgress,
  eMsgProgress                  : E_PROGRESS;
  stMsg                         : ST_Message;
  //-------------------------------------------------------------------------------------------------------------
  tIdleWriteMotion              : TIME := T#5S;
  tIdleWriteApplication         : TIME := T#5S;
  tIdleWriteMetric              : TIME := T#5S;
  tonIdleWriteMotion            : Tc2_Standard.TON;
  tonIdleWriteApplication       : Tc2_Standard.TON;
  tonIdleWriteMetric            : Tc2_Standard.TON;
  //-------------------------------------------------------------------------------------------------------------
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//#################################################################################################################
// Local time; used for timestamps
//#################################################################################################################
GVL_MSG_XTS.fbLocalTime();
GVL_MSG_XTS.sLocalTime                                            := GVL_MSG_XTS.fbLocalTime.LocalTimeString;
GVL_MSG_XTS.dtLocalTime                                           := GVL_MSG_XTS.fbLocalTime.LocalTime;
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
// check for Initialisation from XtsTransport first
//  - wait for XtsTransport to be fully started up
//-----------------------------------------------------------------------------------------------------------------
IF NOT (eInitXtsTransport = E_PROGRESS.PROGRESS_DONE) THEN eInit  := E_PROGRESS.PROGRESS_INVALID; RETURN; END_IF
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
// initialization for:
//  - configuring processes
//  - starting up of processes
//  - cross checking with the rest of your application
//-----------------------------------------------------------------------------------------------------------------
CASE eInit
OF
  E_PROGRESS.PROGRESS_INVALID:
    eInit                                         := E_PROGRESS.PROGRESS_INIT;

  E_PROGRESS.PROGRESS_INIT:
    // init processes
    eInit                                         := E_PROGRESS.PROGRESS_BUSY;
    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_ONE].ProcessId         := DISTRIBUTOR_ONE;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_ONE].StationFirst      :=   37;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_ONE].StationLast       :=   37;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorOne.ProcessId                    := DISTRIBUTOR_ONE;
    GVL_APPLICATION.InstanceDistributorOne.ProcessTarget                := PROCESS_ONE;
    GVL_APPLICATION.InstanceDistributorOne.CheckPositionStart           :=  7500.0;
    GVL_APPLICATION.InstanceDistributorOne.CheckPositionEnd             :=  7900.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorOne.CollectorInterface           :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceDistributorOne.ProcessLinkedLists           :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceDistributorOne.InstanceCtrl                 REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceDistributorOne.InstanceState                REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[PROCESS_ONE].ProcessId             := PROCESS_ONE;
    GVL_APPLICATION.ProcessCollector[PROCESS_ONE].StationFirst          :=    1;
    GVL_APPLICATION.ProcessCollector[PROCESS_ONE].StationLast           :=    3;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceProcessOne.ProcessId                        := PROCESS_ONE;
    GVL_APPLICATION.InstanceProcessOne.ProcessTarget                    := DISTRIBUTOR_TWO;
    GVL_APPLICATION.InstanceProcessOne.CheckPositionStart               :=  7500.0;
    GVL_APPLICATION.InstanceProcessOne.CheckPositionEnd                 :=   200.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceProcessOne.CollectorInterface               :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceProcessOne.ProcessLinkedLists               :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceProcessOne.InstanceCtrl                     REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceProcessOne.InstanceState                    REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_TWO].ProcessId         := DISTRIBUTOR_TWO;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_TWO].StationFirst      :=    41;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_TWO].StationLast       :=    41;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorTwo.ProcessId                    := DISTRIBUTOR_TWO;
    GVL_APPLICATION.InstanceDistributorTwo.ProcessTarget                := PROCESS_TWO;
    GVL_APPLICATION.InstanceDistributorTwo.CheckPositionStart           :=  250.0;
    GVL_APPLICATION.InstanceDistributorTwo.CheckPositionEnd             :=  550.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorTwo.CollectorInterface           :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceDistributorTwo.ProcessLinkedLists           :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceDistributorTwo.InstanceCtrl                 REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceDistributorTwo.InstanceState                REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[PROCESS_TWO].ProcessId             := PROCESS_TWO;
    GVL_APPLICATION.ProcessCollector[PROCESS_TWO].StationFirst          :=    4;
    GVL_APPLICATION.ProcessCollector[PROCESS_TWO].StationLast           :=    7;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceProcessTwo.ProcessId                        := PROCESS_TWO;
    GVL_APPLICATION.InstanceProcessTwo.ProcessTarget                    := DISTRIBUTOR_THREE;
    GVL_APPLICATION.InstanceProcessTwo.CheckPositionStart               := 550.0;
    GVL_APPLICATION.InstanceProcessTwo.CheckPositionEnd                 := 900.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceProcessTwo.CollectorInterface               :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceProcessTwo.ProcessLinkedLists               :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceProcessTwo.InstanceCtrl                     REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceProcessTwo.InstanceState                    REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_THREE].ProcessId       := DISTRIBUTOR_THREE;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_THREE].StationFirst    :=    43;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_THREE].StationLast     :=    43;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorThree.ProcessId                  := DISTRIBUTOR_THREE;
    GVL_APPLICATION.InstanceDistributorThree.ProcessTarget              := PROCESS_THREE;
    GVL_APPLICATION.InstanceDistributorThree.CheckPositionStart         := 900.0;
    GVL_APPLICATION.InstanceDistributorThree.CheckPositionEnd           := 1600.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorThree.CollectorInterface         :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceDistributorThree.ProcessLinkedLists         :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceDistributorThree.InstanceCtrl               REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceDistributorThree.InstanceState              REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[PROCESS_THREE].ProcessId           := PROCESS_THREE;
    GVL_APPLICATION.ProcessCollector[PROCESS_THREE].StationFirst        :=    8;
    GVL_APPLICATION.ProcessCollector[PROCESS_THREE].StationLast         :=    12;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceProcessThree.ProcessId                      := PROCESS_THREE;
    GVL_APPLICATION.InstanceProcessThree.ProcessTarget                  := DISTRIBUTOR_FOUR;
    GVL_APPLICATION.InstanceProcessThree.CheckPositionStart             := 1000.0;
    GVL_APPLICATION.InstanceProcessThree.CheckPositionEnd               := 2000.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceProcessThree.CollectorInterface             :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceProcessThree.ProcessLinkedLists             :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceProcessThree.InstanceCtrl                   REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceProcessThree.InstanceState                  REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    TargetMask[DISTRIBUTOR_FOUR][1]                                    := 2#_0000_0011;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_FOUR].ProcessId        := DISTRIBUTOR_FOUR;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_FOUR].StationFirst     :=    45;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_FOUR].StationLast      :=    45;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_FOUR].TargetMask       := TargetMask[DISTRIBUTOR_FOUR];
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorFour.ProcessId                   := DISTRIBUTOR_FOUR;
    GVL_APPLICATION.InstanceDistributorFour.ProcessTarget               := PROCESS_FOUR;
    GVL_APPLICATION.InstanceDistributorFour.CheckPositionStart          := 2000.0;
    GVL_APPLICATION.InstanceDistributorFour.CheckPositionEnd            := 2900.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorFour.CollectorInterface          :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceDistributorFour.ProcessLinkedLists          :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceDistributorFour.InstanceCtrl                REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceDistributorFour.InstanceState               REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[PROCESS_FOUR].ProcessId            := PROCESS_FOUR;
    GVL_APPLICATION.ProcessCollector[PROCESS_FOUR].StationFirst         :=    13;
    GVL_APPLICATION.ProcessCollector[PROCESS_FOUR].StationLast          :=    18;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceProcessFour.ProcessId                       := PROCESS_FOUR;
    GVL_APPLICATION.InstanceProcessFour.ProcessTarget                   := DISTRIBUTOR_FIVE;
    GVL_APPLICATION.InstanceProcessFour.CheckPositionStart              := 2500.0;
    GVL_APPLICATION.InstanceProcessFour.CheckPositionEnd                := 3500.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceProcessFour.CollectorInterface              :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceProcessFour.ProcessLinkedLists              :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceProcessFour.InstanceCtrl                    REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceProcessFour.InstanceState                   REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    TargetMask[DISTRIBUTOR_FIVE][1]                                    := 2#_0000_0011;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_FIVE].ProcessId        := DISTRIBUTOR_FIVE;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_FIVE].StationFirst     :=    47;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_FIVE].StationLast      :=    47;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_FIVE].TargetMask       := TargetMask[DISTRIBUTOR_FIVE];
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorFive.ProcessId                   := DISTRIBUTOR_FIVE;
    GVL_APPLICATION.InstanceDistributorFive.ProcessTarget               := PROCESS_FIVE;
    GVL_APPLICATION.InstanceDistributorFive.CheckPositionStart          := 3000.0;
    GVL_APPLICATION.InstanceDistributorFive.CheckPositionEnd            := 4100.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorFive.CollectorInterface          :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceDistributorFive.ProcessLinkedLists          :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceDistributorFive.InstanceCtrl                REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceDistributorFive.InstanceState               REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[PROCESS_FIVE].ProcessId            := PROCESS_FIVE;
    GVL_APPLICATION.ProcessCollector[PROCESS_FIVE].StationFirst         :=    19;
    GVL_APPLICATION.ProcessCollector[PROCESS_FIVE].StationLast          :=    21;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceProcessFive.ProcessId                       := PROCESS_FIVE;
    GVL_APPLICATION.InstanceProcessFive.ProcessTarget                   := DISTRIBUTOR_SIX;
    GVL_APPLICATION.InstanceProcessFive.CheckPositionStart              := 3000.0;
    GVL_APPLICATION.InstanceProcessFive.CheckPositionEnd                := 4200.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceProcessFive.CollectorInterface              :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceProcessFive.ProcessLinkedLists              :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceProcessFive.InstanceCtrl                    REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceProcessFive.InstanceState                   REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_SIX].ProcessId         := DISTRIBUTOR_SIX;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_SIX].StationFirst      :=    49;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_SIX].StationLast       :=    49;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorSix.ProcessId                    := DISTRIBUTOR_SIX;
    GVL_APPLICATION.InstanceDistributorSix.ProcessTarget                := PROCESS_SIX;
    GVL_APPLICATION.InstanceDistributorSix.CheckPositionStart           := 4500.0;
    GVL_APPLICATION.InstanceDistributorSix.CheckPositionEnd             := 4750.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorSix.CollectorInterface           :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceDistributorSix.ProcessLinkedLists           :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceDistributorSix.InstanceCtrl                 REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceDistributorSix.InstanceState                REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[PROCESS_SIX].ProcessId             := PROCESS_SIX;
    GVL_APPLICATION.ProcessCollector[PROCESS_SIX].StationFirst          :=    22;
    GVL_APPLICATION.ProcessCollector[PROCESS_SIX].StationLast           :=    25;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceProcessSix.ProcessId                        := PROCESS_SIX;
    GVL_APPLICATION.InstanceProcessSix.ProcessTarget                    := DISTRIBUTOR_SEVEN;
    GVL_APPLICATION.InstanceProcessSix.CheckPositionStart               := 4500.0;
    GVL_APPLICATION.InstanceProcessSix.CheckPositionEnd                 := 5250.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceProcessSix.CollectorInterface               :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceProcessSix.ProcessLinkedLists               :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceProcessSix.InstanceCtrl                     REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceProcessSix.InstanceState                    REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_SEVEN].ProcessId       := DISTRIBUTOR_SEVEN;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_SEVEN].StationFirst    :=    51;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_SEVEN].StationLast     :=    51;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorSeven.ProcessId                  := DISTRIBUTOR_SEVEN;
    GVL_APPLICATION.InstanceDistributorSeven.ProcessTarget              := PROCESS_SEVEN;
    GVL_APPLICATION.InstanceDistributorSeven.CheckPositionStart         := 5000.0;
    GVL_APPLICATION.InstanceDistributorSeven.CheckPositionEnd           := 5600.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorSeven.CollectorInterface         :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceDistributorSeven.ProcessLinkedLists         :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceDistributorSeven.InstanceCtrl               REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceDistributorSeven.InstanceState              REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[PROCESS_SEVEN].ProcessId           := PROCESS_SEVEN;
    GVL_APPLICATION.ProcessCollector[PROCESS_SEVEN].StationFirst        :=    26;
    GVL_APPLICATION.ProcessCollector[PROCESS_SEVEN].StationLast         :=    30;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceProcessSeven.ProcessId                      := PROCESS_SEVEN;
    GVL_APPLICATION.InstanceProcessSeven.ProcessTarget                  := DISTRIBUTOR_EIGHT;
    GVL_APPLICATION.InstanceProcessSeven.CheckPositionStart             := 5500.0;
    GVL_APPLICATION.InstanceProcessSeven.CheckPositionEnd               := 6100.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceProcessSeven.CollectorInterface             :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceProcessSeven.ProcessLinkedLists             :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceProcessSeven.InstanceCtrl                   REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceProcessSeven.InstanceState                  REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_EIGHT].ProcessId       := DISTRIBUTOR_EIGHT;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_EIGHT].StationFirst    :=    53;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_EIGHT].StationLast     :=    53;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorEight.ProcessId                  := DISTRIBUTOR_EIGHT;
    GVL_APPLICATION.InstanceDistributorEight.ProcessTarget              := PROCESS_EIGHT;
    GVL_APPLICATION.InstanceDistributorEight.CheckPositionStart         := 6500.0;
    GVL_APPLICATION.InstanceDistributorEight.CheckPositionEnd           := 7000.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorEight.CollectorInterface         :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceDistributorEight.ProcessLinkedLists         :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceDistributorEight.InstanceCtrl               REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceDistributorEight.InstanceState              REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[PROCESS_EIGHT].ProcessId           := PROCESS_EIGHT;
    GVL_APPLICATION.ProcessCollector[PROCESS_EIGHT].StationFirst        :=    31;
    GVL_APPLICATION.ProcessCollector[PROCESS_EIGHT].StationLast         :=    36;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceProcessEight.ProcessId                      := PROCESS_EIGHT;
    GVL_APPLICATION.InstanceProcessEight.ProcessTarget                  := DISTRIBUTOR_ONE;
    GVL_APPLICATION.InstanceProcessEight.CheckPositionStart             := 6800.0;
    GVL_APPLICATION.InstanceProcessEight.CheckPositionEnd               := 7500.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceProcessEight.CollectorInterface             :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceProcessEight.ProcessLinkedLists             :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceProcessEight.InstanceCtrl                   REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceProcessEight.InstanceState                  REF= GVL_APPLICATION.InstanceState;



  E_PROGRESS.PROGRESS_BUSY:
    // init the conductor
    GVL_APPLICATION.ConductorCtrl.Cmd             := E_INSTANCE_CMD.INIT;
    // init the instances
    idx                                           := 1;
    memset(ADR(GVL_APPLICATION.InstanceCtrl), 0, SIZEOF(GVL_APPLICATION.InstanceCtrl));
    eInit                                         := E_PROGRESS.PROGRESS_PREPARE;

  E_PROGRESS.PROGRESS_PREPARE:
    GVL_APPLICATION.InstanceCtrl[idx].Cmd         := E_INSTANCE_CMD.INIT;

    IF (GVL_APPLICATION.InstanceState[idx].ProcessState   = E_INSTANCE_STATE.DISABLED)
    THEN
      IF (GVL_APPLICATION.InstanceState[idx].ProcessProgress = E_PROGRESS.PROGRESS_BUSY)
      THEN
        GVL_APPLICATION.InstanceCtrl[idx].Cmd     := E_INSTANCE_CMD.DISABLE;
        eInit                                     := E_PROGRESS.PROGRESS_STARTUP;
      END_IF
    END_IF


  E_PROGRESS.PROGRESS_STARTUP:
    IF NOT (idx < GVL_APPLICATION.MAX_PROCESS)
    THEN
      eInit                                       := E_PROGRESS.PROGRESS_CHECK;
    ELSE
      idx                                         := idx + 1;
      eInit                                       := E_PROGRESS.PROGRESS_PREPARE;
    END_IF

  E_PROGRESS.PROGRESS_CHECK:
    GVL_APPLICATION.ConductorCtrl.Cmd             := E_INSTANCE_CMD.ENABLE;
    eInit                                         := E_PROGRESS.PROGRESS_OCCUPIED;

  E_PROGRESS.PROGRESS_OCCUPIED:
    eInit                                         := E_PROGRESS.PROGRESS_WORKING;

  E_PROGRESS.PROGRESS_WORKING:
    eInit                                         := E_PROGRESS.PROGRESS_DONE;
END_CASE
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
// /assign dataflow
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
//  - The YardMaster
//-----------------------------------------------------------------------------------------------------------------
GVL_APPLICATION.YardMaster.Ctrl                               REF= GVL_APPLICATION.YardControl;
GVL_APPLICATION.YardMaster.State                              REF= GVL_APPLICATION.YardState;

GVL_APPLICATION.YardMaster.XtsTransportCtrl                   REF= GVL_XTS.XtsTransportCtrl;
GVL_APPLICATION.YardMaster.XtsTransportState                  REF= GVL_XTS.XtsTransportState;

GVL_APPLICATION.YardMaster.CollectorInterfaces                :=   GVL_APPLICATION.ItfProcessCollector;
GVL_APPLICATION.YardMaster.TicketList                         :=   GVL_APPLICATION.TicketList;
GVL_APPLICATION.YardMaster();
//-----------------------------------------------------------------------------------------------------------------
//  - ProcessCollectors
//-----------------------------------------------------------------------------------------------------------------
FOR nProcess := 1 TO MAX_PROCESS
DO
  GVL_APPLICATION.ItfProcessList[nProcess]                    :=   GVL_APPLICATION.ProcessList[nProcess];
  GVL_APPLICATION.ItfProcessCollector[nProcess]               :=   GVL_APPLICATION.ProcessCollector[nProcess];

  GVL_APPLICATION.ProcessCollector[nProcess].MessageLevel     :=   GVL_MSG_XTS.MessageLevelProcess[nProcess];
  GVL_APPLICATION.ProcessCollector[nProcess].MoverInfo        REF= GVL_XTS.MoverInfo;
  GVL_APPLICATION.ProcessCollector[nProcess].StationCtrl      REF= GVL_XTS.StationCtrl;
  GVL_APPLICATION.ProcessCollector[nProcess].StationState     REF= GVL_XTS.StationState;
  GVL_APPLICATION.ProcessCollector[nProcess].TargetMask       := TargetMask[nProcess];
  GVL_APPLICATION.ProcessCollector[nProcess].Cycle();
END_FOR

//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
// cyclic TicketList as inbox
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
GVL_APPLICATION.TicketControl.ItfList                         :=   GVL_APPLICATION.TicketList;
GVL_APPLICATION.TicketControl.Ctrl                            REF= GVL_APPLICATION.TicketListControl;
GVL_APPLICATION.TicketControl.State                           REF= GVL_APPLICATION.TicketListState;
GVL_APPLICATION.TicketControl.NodeDataInput                   REF= GVL_APPLICATION.TicketListDataInput;
GVL_APPLICATION.TicketControl.NodeDataOutput                  REF= GVL_APPLICATION.TicketListDataOutput;
GVL_APPLICATION.TicketControl();
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
// Conductor
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
GVL_APPLICATION.ProcessConductor.ProcessLinkedLists           :=   GVL_APPLICATION.ItfProcessList;
GVL_APPLICATION.ProcessConductor.TicketLinkedList             :=   GVL_APPLICATION.TicketList;
GVL_APPLICATION.ProcessConductor.Ctrl                         REF= GVL_APPLICATION.ConductorCtrl;
GVL_APPLICATION.ProcessConductor.State                        REF= GVL_APPLICATION.ConductorState;
GVL_APPLICATION.ProcessConductor();
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
// Instance calls
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
GVL_APPLICATION.InstanceDistributorOne();
GVL_APPLICATION.InstanceDistributorTwo();
GVL_APPLICATION.InstanceDistributorThree();
GVL_APPLICATION.InstanceDistributorFour();
GVL_APPLICATION.InstanceDistributorFive();
GVL_APPLICATION.InstanceDistributorSix();
GVL_APPLICATION.InstanceDistributorSeven();
GVL_APPLICATION.InstanceDistributorEight();

GVL_APPLICATION.InstanceProcessOne();
GVL_APPLICATION.InstanceProcessTwo();
GVL_APPLICATION.InstanceProcessThree();
GVL_APPLICATION.InstanceProcessFour();
GVL_APPLICATION.InstanceProcessFive();
GVL_APPLICATION.InstanceProcessSix();
GVL_APPLICATION.InstanceProcessSeven();
GVL_APPLICATION.InstanceProcessEight();
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
//#################################################################################################################
//  /logging
//    - all life is problem solving
//#################################################################################################################
GVL_MSG_XTS.TransportMessageData.Ctrl               REF= GVL_MSG_XTS.TransportMessageCtrl;
GVL_MSG_XTS.TransportMessageData.State              REF= GVL_MSG_XTS.TransportMessageState;
GVL_MSG_XTS.TransportMessageData.MessageIndex       REF= GVL_MSG_XTS.MessageTransportIndex;
GVL_MSG_XTS.TransportMessageData.ErrorIndex         REF= GVL_MSG_XTS.MessageTransportError;
GVL_MSG_XTS.TransportMessageData.DirRoot            :=   ADR(GVL_MSG_XTS.LOG_DIR);
GVL_MSG_XTS.TransportMessageData.FileRoot           :=   ADR(GVL_MSG_XTS.LOG_FILE);
GVL_MSG_XTS.TransportMessageData.MsgList            :=   ADR(GVL_MSG_XTS.TransportMessages);
GVL_MSG_XTS.TransportMessageData.LocalTime          :=   ADR(GVL_MSG_XTS.dtLocalTime);
GVL_MSG_XTS.TransportMessageData();
eMsgState                                       :=   f_GetState   (GVL_MSG_XTS.TransportMessageState.State);
eMsgProgress                                    :=   f_GetProgress(GVL_MSG_XTS.TransportMessageState.State);

CASE eMsgState
OF
  E_MESSAGE_STATE.MSG_STATE_NULL:
    CASE eMsgProgress
    OF
      E_PROGRESS.PROGRESS_INVALID,
      E_PROGRESS.PROGRESS_DONE:
        IF (GVL_MSG_XTS.MessageTransportIndex > GVL_MSG_XTS.MAX_MESSAGE/101) OR
           (GVL_MSG_XTS.MessageTransportError > 0)
        THEN
          GVL_MSG_XTS.TransportMessageCtrl.Cmd      := E_MESSAGE_CTRL.MSG_CTRL_WRITE;
        ELSE
          tonIdleWriteMotion(IN := TRUE, PT:= tIdleWriteMotion);
          IF (tonIdleWriteMotion.Q)
          THEN
            GVL_MSG_XTS.TransportMessageCtrl.Cmd    := E_MESSAGE_CTRL.MSG_CTRL_WRITE;
          END_IF
        END_IF
    END_CASE

  E_MESSAGE_STATE.MSG_STATE_WRITE:
    CASE eMsgProgress
    OF
      E_PROGRESS.PROGRESS_ERROR,
      E_PROGRESS.PROGRESS_DONE:
          tonIdleWriteMotion(IN := FALSE, PT:= tIdleWriteMotion);
        GVL_MSG_XTS.TransportMessageCtrl.Cmd        := E_MESSAGE_CTRL.MSG_CTRL_NULL;
    END_CASE

ELSE
    CASE eMsgProgress
    OF
      E_PROGRESS.PROGRESS_DONE:
          tonIdleWriteMotion(IN := FALSE, PT:= tIdleWriteMotion);
        GVL_MSG_XTS.TransportMessageCtrl.Cmd        := E_MESSAGE_CTRL.MSG_CTRL_NULL;
    END_CASE
END_CASE
//#################################################################################################################
// /application logging
//#################################################################################################################
GVL_MSG_XTS.ApplicationMessageData.Ctrl                         REF= GVL_MSG_XTS.ApplicationMessageCtrl;
GVL_MSG_XTS.ApplicationMessageData.State                        REF= GVL_MSG_XTS.ApplicationMessageState;

GVL_MSG_XTS.ApplicationMessageData.MessageIndex                 REF= GVL_MSG_XTS.MessageApplicationIndex;
GVL_MSG_XTS.ApplicationMessageData.ErrorIndex                   REF= GVL_MSG_XTS.MessageApplicationError;

GVL_MSG_XTS.ApplicationMessageData.DirRoot                      :=   ADR(GVL_MSG_XTS.LOG_DIR);
GVL_MSG_XTS.ApplicationMessageData.FileRoot                     :=   ADR(GVL_MSG_XTS.LOG_FILE_APP);
GVL_MSG_XTS.ApplicationMessageData.MsgList                      :=   ADR(GVL_MSG_XTS.ApplicationMessages);
GVL_MSG_XTS.ApplicationMessageData.LocalTime                    :=   ADR(GVL_MSG_XTS.dtLocalTime);

GVL_MSG_XTS.ApplicationMessageData();

eMsgState                                       := f_GetState   (GVL_MSG_XTS.ApplicationMessageState.State);
eMsgProgress                                    := f_GetProgress(GVL_MSG_XTS.ApplicationMessageState.State);


CASE eMsgState
OF
  E_MESSAGE_STATE.MSG_STATE_NULL:
    CASE eMsgProgress
    OF
      E_PROGRESS.PROGRESS_INVALID:
        IF (GVL_MSG_XTS.MessageApplicationIndex > GVL_MSG_XTS.MAX_MESSAGE/13) OR
           (GVL_MSG_XTS.MessageApplicationError > 0)
        THEN
          GVL_MSG_XTS.ApplicationMessageCtrl.Cmd                := E_MESSAGE_CTRL.MSG_CTRL_WRITE;
        ELSE
          tonIdleWriteApplication(IN := TRUE, PT:= tIdleWriteApplication);
          IF (tonIdleWriteApplication.Q)
          THEN
            GVL_MSG_XTS.ApplicationMessageCtrl.Cmd              := E_MESSAGE_CTRL.MSG_CTRL_WRITE;
          END_IF
        END_IF
    END_CASE

  E_MESSAGE_STATE.MSG_STATE_WRITE:
    CASE eMsgProgress
    OF
      E_PROGRESS.PROGRESS_ERROR,
      E_PROGRESS.PROGRESS_DONE:
        tonIdleWriteApplication(IN := FALSE, PT:= tIdleWriteApplication);
        GVL_MSG_XTS.ApplicationMessageCtrl.Cmd                  := E_MESSAGE_CTRL.MSG_CTRL_NULL;
    END_CASE

ELSE
    CASE eMsgProgress
    OF
      E_PROGRESS.PROGRESS_DONE:
        tonIdleWriteApplication(IN := FALSE, PT:= tIdleWriteApplication);
        GVL_MSG_XTS.ApplicationMessageCtrl.Cmd                  := E_MESSAGE_CTRL.MSG_CTRL_NULL;
    END_CASE
END_CASE
//#################################################################################################################
// logging/
//#################################################################################################################
//#################################################################################################################
//  /Transport Metrics
//#################################################################################################################
GVL_MSG_XTS.MetricsMessageData.Ctrl                             REF= GVL_MSG_XTS.MetricsMessageCtrl;
GVL_MSG_XTS.MetricsMessageData.State                            REF= GVL_MSG_XTS.MetricsMessageState;

GVL_MSG_XTS.MetricsMessageData.MessageIndex                     REF= GVL_MSG_XTS.MessageMetricsIndex;
GVL_MSG_XTS.MetricsMessageData.ErrorIndex                       REF= GVL_MSG_XTS.MessageMetricsError;

GVL_MSG_XTS.MetricsMessageData.DirRoot                          :=   ADR(GVL_MSG_XTS.LOG_DIR);
GVL_MSG_XTS.MetricsMessageData.FileRoot                         :=   ADR(GVL_MSG_XTS.LOG_FILE_METRIC);
GVL_MSG_XTS.MetricsMessageData.MsgList                          :=   ADR(GVL_MSG_XTS.MetricsMessages);
GVL_MSG_XTS.MetricsMessageData.LocalTime                        :=   ADR(GVL_MSG_XTS.dtLocalTime);

GVL_MSG_XTS.MetricsMessageData();

eMtrState                                   := f_GetState   (GVL_MSG_XTS.MetricsMessageState.State);
eMtrProgress                                := f_GetProgress(GVL_MSG_XTS.MetricsMessageState.State);

CASE eMtrState
OF
  E_MESSAGE_STATE.MSG_STATE_NULL:
    CASE eMtrProgress
    OF
      E_PROGRESS.PROGRESS_INVALID:
        IF (GVL_MSG_XTS.MessageMetricsIndex > GVL_MSG_XTS.MAX_MESSAGE/5) OR
           (GVL_MSG_XTS.MessageMetricsError > 0)
        THEN
          GVL_MSG_XTS.MetricsMessageCtrl.Cmd                    := E_MESSAGE_CTRL.MSG_CTRL_WRITE;
        ELSE
          tonIdleWriteMetric(IN := TRUE, PT:= tIdleWriteMetric);
          IF (tonIdleWriteMetric.Q)
          THEN
            GVL_MSG_XTS.MetricsMessageCtrl.Cmd                  := E_MESSAGE_CTRL.MSG_CTRL_WRITE;
          END_IF
        END_IF
    END_CASE

  E_MESSAGE_STATE.MSG_STATE_WRITE:
    CASE eMtrProgress
    OF
      E_PROGRESS.PROGRESS_ERROR,
      E_PROGRESS.PROGRESS_DONE:
        tonIdleWriteMetric(IN := FALSE, PT:= tIdleWriteMetric);
        GVL_MSG_XTS.MetricsMessageCtrl.Cmd                      := E_MESSAGE_CTRL.MSG_CTRL_NULL;
    END_CASE
ELSE
    CASE eMtrProgress
    OF
      E_PROGRESS.PROGRESS_DONE:
        tonIdleWriteMetric(IN := FALSE, PT:= tIdleWriteMetric);
        GVL_MSG_XTS.MetricsMessageCtrl.Cmd                      := E_MESSAGE_CTRL.MSG_CTRL_NULL;
    END_CASE
END_CASE
//#################################################################################################################
//  Transport Metrics/
//#################################################################################################################
//#################################################################################################################
//#################################################################################################################
]]></ST>
    </Implementation>
    <Action Name="Init" Id="{69838e0d-19cf-48fe-8b42-ee1af1eba2b6}">
      <Implementation>
        <ST><![CDATA[CASE eInit
OF
  E_PROGRESS.PROGRESS_INVALID:          // startup procedure for your application
    eInit                               := E_PROGRESS.PROGRESS_INIT;

  E_PROGRESS.PROGRESS_INIT:
      nProcess                                        := 1;
      tProcess[nProcess]                              := T#750MS;

      GVL_APPLICATION.Simulation[nProcess].HandshakeRoute:= E_PROCESS_HANDSHAKE.E_SHAKE_DOUBLE;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 1;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 16;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 20;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 35;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      GVL_APPLICATION.Simulation[nProcess].CheckRangeLow :=   10.0;
      GVL_APPLICATION.Simulation[nProcess].CheckRangeHigh:= 1600.0;

      //---------------------------------------------------------

      // 2

      //---------------------------------------------------------
      nProcess                                        := 3;
      tProcess[nProcess]                              := T#2400MS;

      GVL_APPLICATION.Simulation[nProcess].HandshakeRoute:= E_PROCESS_HANDSHAKE.E_SHAKE_DOUBLE;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 20;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 35;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 37;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 37;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      GVL_APPLICATION.Simulation[nProcess].CheckRangeLow := 9000.0;
      GVL_APPLICATION.Simulation[nProcess].CheckRangeHigh:= 12100.0;

      //---------------------------------------------------------
      nProcess                                        := 4;
      tProcess[nProcess]                              := T#0MS;

      GVL_APPLICATION.Simulation[nProcess].HandshakeRoute:= E_PROCESS_HANDSHAKE.E_SHAKE_SEND;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 37;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 37;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 38;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 38;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      GVL_APPLICATION.Simulation[nProcess].CheckRangeLow := 12850.0;
      GVL_APPLICATION.Simulation[nProcess].CheckRangeHigh:= 13000.0;

      //---------------------------------------------------------
      nProcess                                        := 5;
      tProcess[nProcess]                              := T#0MS;

      GVL_APPLICATION.Simulation[nProcess].HandshakeRoute:= E_PROCESS_HANDSHAKE.E_SHAKE_SEND;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 38;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 38;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 39;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 39;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      GVL_APPLICATION.Simulation[nProcess].CheckRangeLow := 13900.0;
      GVL_APPLICATION.Simulation[nProcess].CheckRangeHigh:= 14100.0;

      //---------------------------------------------------------
      nProcess                                        := 6;
      tProcess[nProcess]                              := T#0MS;

      GVL_APPLICATION.Simulation[nProcess].HandshakeRoute:= E_PROCESS_HANDSHAKE.E_SHAKE_SEND;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 39;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 39;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 41;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 52;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      GVL_APPLICATION.Simulation[nProcess].CheckRangeLow := 14200.0;
      GVL_APPLICATION.Simulation[nProcess].CheckRangeHigh:= 14400.0;

      //---------------------------------------------------------
      nProcess                                        := 7;
      tProcess[nProcess]                              := T#3200MS;

      GVL_APPLICATION.Simulation[nProcess].HandshakeRoute:= E_PROCESS_HANDSHAKE.E_SHAKE_FAST;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 41;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 52;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 57;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 57;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      GVL_APPLICATION.Simulation[nProcess].CheckRangeLow := 14400.0;
      GVL_APPLICATION.Simulation[nProcess].CheckRangeHigh:= 17000.0;

      //---------------------------------------------------------
      nProcess                                        := 8;
      tProcess[nProcess]                              := T#0MS;

      GVL_APPLICATION.Simulation[nProcess].HandshakeRoute:= E_PROCESS_HANDSHAKE.E_SHAKE_SEND;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 57;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 57;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 58;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 65;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      GVL_APPLICATION.Simulation[nProcess].CheckRangeLow := 17500.0;
      GVL_APPLICATION.Simulation[nProcess].CheckRangeHigh:= 18100.0;

      //---------------------------------------------------------
      nProcess                                        := 9;
      tProcess[nProcess]                              := T#3200MS;

      GVL_APPLICATION.Simulation[nProcess].HandshakeRoute:= E_PROCESS_HANDSHAKE.E_SHAKE_SINGLE;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 58;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 65;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 70;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 70;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      GVL_APPLICATION.Simulation[nProcess].CheckRangeLow := 19400.0;
      GVL_APPLICATION.Simulation[nProcess].CheckRangeHigh:= 20500.0;

      //---------------------------------------------------------
      nProcess                                        := 10;
      tProcess[nProcess]                              := T#0MS;

      GVL_APPLICATION.Simulation[nProcess].HandshakeRoute:= E_PROCESS_HANDSHAKE.E_SHAKE_SEND;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 70;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 70;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 71;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 82;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      GVL_APPLICATION.Simulation[nProcess].CheckRangeLow := 20600.0;
      GVL_APPLICATION.Simulation[nProcess].CheckRangeHigh:= 21400.0;

      //---------------------------------------------------------
      nProcess                                        := 12;
      tProcess[nProcess]                              := T#4600MS;

      GVL_APPLICATION.Simulation[nProcess].HandshakeRoute:= E_PROCESS_HANDSHAKE.E_SHAKE_DOUBLE;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 71;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 82;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 91;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 91;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      GVL_APPLICATION.Simulation[nProcess].CheckRangeLow := 21400.0;
      GVL_APPLICATION.Simulation[nProcess].CheckRangeHigh:= 22800.0;

      //---------------------------------------------------------
      nProcess                                        := 13;
      tProcess[nProcess]                              := T#00MS;

      GVL_APPLICATION.Simulation[nProcess].HandshakeRoute:= E_PROCESS_HANDSHAKE.E_SHAKE_SEND;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 91;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 91;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 95;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 95;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      GVL_APPLICATION.Simulation[nProcess].CheckRangeLow := 22800.0;
      GVL_APPLICATION.Simulation[nProcess].CheckRangeHigh:= 23500.0;

      //---------------------------------------------------------
      nProcess                                        := 14;
      tProcess[nProcess]                              := T#0MS;

      GVL_APPLICATION.Simulation[nProcess].HandshakeRoute:= E_PROCESS_HANDSHAKE.E_SHAKE_SEND;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 95;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 95;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 120;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 133;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      GVL_APPLICATION.Simulation[nProcess].CheckRangeLow := 24000.0;
      GVL_APPLICATION.Simulation[nProcess].CheckRangeHigh:= 24100.0;

      //---------------------------------------------------------
      nProcess                                        := 15;
      tProcess[nProcess]                              := T#2500MS;

      GVL_APPLICATION.Simulation[nProcess].HandshakeRoute:= E_PROCESS_HANDSHAKE.E_SHAKE_DOUBLE;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 120;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 133;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 140;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 140;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      GVL_APPLICATION.Simulation[nProcess].CheckRangeLow := 24200.0;
      GVL_APPLICATION.Simulation[nProcess].CheckRangeHigh:= 27500.0;

      //---------------------------------------------------------
      nProcess                                        := 16;
      tProcess[nProcess]                              := T#0MS;

      GVL_APPLICATION.Simulation[nProcess].HandshakeRoute:= E_PROCESS_HANDSHAKE.E_SHAKE_SEND;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 140;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 140;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 141;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 141;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      GVL_APPLICATION.Simulation[nProcess].CheckRangeLow := 27970.0;
      GVL_APPLICATION.Simulation[nProcess].CheckRangeHigh:= 1250.0;

      //---------------------------------------------------------
      nProcess                                        := 17;
      tProcess[nProcess]                              := T#0MS;

      GVL_APPLICATION.Simulation[nProcess].HandshakeRoute:= E_PROCESS_HANDSHAKE.E_SHAKE_SEND;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 141;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 141;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 142;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 142;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      GVL_APPLICATION.Simulation[nProcess].CheckRangeLow := 3950.0;
      GVL_APPLICATION.Simulation[nProcess].CheckRangeHigh:= 4100.0;

      //---------------------------------------------------------
      nProcess                                        := 18;
      tProcess[nProcess]                              := T#0MS;

      GVL_APPLICATION.Simulation[nProcess].HandshakeRoute:= E_PROCESS_HANDSHAKE.E_SHAKE_SEND;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 142;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 142;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 20;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 35;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      GVL_APPLICATION.Simulation[nProcess].CheckRangeLow := 4500.0;
      GVL_APPLICATION.Simulation[nProcess].CheckRangeHigh:= 5600.0;


    eInit                                                 := E_PROGRESS.PROGRESS_BUSY;

  E_PROGRESS.PROGRESS_BUSY:
    GVL_MSG_XTS.TransportMessageCtrl.Cmd                  := E_MESSAGE_CTRL.MSG_CTRL_INIT;
    GVL_MSG_XTS.MetricsMessageCtrl.Cmd                    := E_MESSAGE_CTRL.MSG_CTRL_INIT;
    eInit                                                 := E_PROGRESS.PROGRESS_PREPARE;

  E_PROGRESS.PROGRESS_PREPARE:
    eInit                                                 := E_PROGRESS.PROGRESS_STARTUP;

  E_PROGRESS.PROGRESS_STARTUP:
    eInit                                                 := E_PROGRESS.PROGRESS_DONE;
    FOR nProcess := 1 TO MAX_PROCESS
    DO
      IF (GVL_APPLICATION.Simulation[nProcess].StationCount > 0)
      THEN
        GVL_APPLICATION.Simulation[nProcess].EnableProcess := TO_DWORD(EXPT(2,GVL_APPLICATION.Simulation[nProcess].StationCount))-1;
        GVL_APPLICATION.Simulation[nProcess].MoverEnter    := TRUE;
        GVL_APPLICATION.Simulation[nProcess].MoverOut      := TRUE;

      END_IF
    END_FOR
END_CASE
]]></ST>
      </Implementation>
