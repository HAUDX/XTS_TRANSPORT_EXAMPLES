          <ST><![CDATA[_stInstanceState ref= InstanceState;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ProcessId" Id="{b0d1a924-6241-4335-be39-966d3f9b0719}">
      <Declaration><![CDATA[PROPERTY ProcessId : E_INSTANCE]]></Declaration>
      <Get Name="Get" Id="{4b563e78-35ca-46fa-a429-91bad99e170e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ProcessId := _nProcess;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{566aa5ef-d2c9-4a5c-8d5d-3fca3942f3dd}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_nProcess := ProcessId;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ProcessId_Connect" Id="{abcc06e1-efe7-4aa9-9516-be1588519f38}">
      <Declaration><![CDATA[PROPERTY ProcessId_Connect : E_INSTANCE]]></Declaration>
      <Get Name="Get" Id="{b63ddabd-1e94-4d54-b9cd-0e5cfc49b660}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ProcessId_Connect := _nProcessConnect;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{97104ab0-4bc8-47e4-aa6e-413c64ff8466}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_nProcessConnect := ProcessId_Connect;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ProcessId_ConnectTarget" Id="{da385cf2-47a3-4307-bcdb-9af574222ed1}">
      <Declaration><![CDATA[PROPERTY ProcessId_ConnectTarget : E_INSTANCE]]></Declaration>
      <Get Name="Get" Id="{e9f241da-b82b-4801-b1f0-50eb7bef7352}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ProcessId_ConnectTarget := _nProcessConnectTarget;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{95ea77ba-8c13-4f5b-b98e-17a763290a3b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_nProcessConnectTarget := ProcessId_ConnectTarget;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="TicketLinkedList" Id="{47e1ba62-2d3b-414e-8705-080e812d120b}">
      <Declaration><![CDATA[PROPERTY TicketLinkedList : I_Process_LinkedList]]></Declaration>
      <Set Name="Set" Id="{567f8792-66d5-433e-904b-9d5e5e8f13f8}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ItfTicketList := TicketLinkedList;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="TruncMask" Id="{1e1b7bd6-e3e6-45f2-a35b-d0a434ac7ca6}">
      <Declaration><![CDATA[METHOD TruncMask : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// transfer station mask only in the range possible to handle in connected process (StationCount)
_stProcessData.nProcessId                 := _nProcess;
_stProcessData.nTargetId                  := _nProcessConnect;

FOR _tdx := 1 TO _stInstanceState[_nProcessConnect].StationCount
DO
  IF (BitGet(_wActivateStation, _tdx-1))
  THEN
    _stProcessData.wTarget                := BitSet(_stProcessData.wTarget, _tdx-1);
  END_IF      
END_FOR

TruncMask := TRUE;]]></ST>
      </Implementation>
    </Method>
