<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fb_DisposableHeros" Id="{57ff81e0-db35-4988-adb1-755f5d46de47}" SpecialFunc="None">
    <Declaration><![CDATA[//---------------------------------------------------------------------------------------------------------------
//
//  HAUD 2026.11.07
//
//  - TowerControl - fb_DisposableHeros
//
//    - this class is nothing more than the handshake sequence and a timer
//
//    - the station bitmask is written for each production cycle
//      - ticketing involves a DistributorByTicket and its companion ProcessByTicket
//      - this mock up takes care of both tickets.
//        - Why do you need to send 2 tickets?
//          - Distributor and Process instance do not know each other (and this is on purpose to keep things loose and avoid thight coupling by design)
//            --> sending tickets should be done from one place only, so a Distributor sending a ticket internally to its Process would break that rule.
//            --> The Ticket transports the information about where the movers were sent to
//              --> The Process now needs to be told which stations to activate, the rest is ruled by the bitmask from the ticket. 
//
//    - top level transport abstractions are handshaked here:
//    --------------------------------------------
//    - top level transport abstractions
//      - Instances contain the required transport logic
//      - Instances control their assigned ProcessCollector
//      - Instances are controlled in timer based application
//
//
//---------------------------------------------------------------------------------------------------------------
FUNCTION_BLOCK fb_DisposableHeros // Soldier boy, made of clay, now an empty shell
VAR_INPUT
  Start         : BOOL;           // Back to the front
  DwellTime     : TIME;           // Sounding of the clock that ticks
  StationMask   : T_PROCESS;      // molded day by day
END_VAR
VAR
  // process index
  _nProcess               : E_INSTANCE; // whoami
  _nProcessConnect        : e_instance; // to whom am I connected? this is an idea to manage the two tickets for Distributor and Process
  _nProcessConnectTarget  : e_instance; // what is the target of the process to whom I am connected

  _stInstanceCtrl         : REFERENCE TO ARRAY[1..MAX_PROCESS] OF ST_INSTANCE_CTRL;
  _stInstanceState        : REFERENCE TO ARRAY[1..MAX_PROCESS] OF ST_INSTANCE_STATE;

  _wActivateStation       : T_PROCESS;
  _stProcessData          : ST_PROCESS_DATA;

  _ItfTicketList          : I_Process_LinkedList;
  _WriteResult            : ST_PROCESS_LIST_RESULT;

  _nState                 : UINT;
  _tonProcess             : Tc2_Standard.TON;

  _nTicketCount           : UDINT;  // since this is a mock up, there is no-one to clean this up
  _nTicketCountLimit      : UDINT;  // if <> 0 --> limit is active

  _tdx                    : UINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//---------------------------------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------------------------------
// CHECK() ??
// !! this is mock up code, there is no check
//
//---------------------------------------------------------------------------------------------------------------
//---------------------------------------------------------------------------------------------------------------
IF NOT Start THEN _nState   := 0; END_IF
//---------------------------------------------------------------------------------------------------------------
CASE _nState OF
  0:
    IF Start
    THEN
      _nState               := 10;
    END_IF

  10:
    CASE _stInstanceState[_nProcess].ProcessState
    OF
      E_INSTANCE_STATE.DISABLED:
        _stInstanceCtrl[_nProcess].Cmd        := E_INSTANCE_CMD.ENABLE;
        IF (_nProcessConnect > e_instance.INSTANCE_NULL)
        THEN
          memset(ADR(_stProcessData), 0, SIZEOF(_stProcessData));
          _nState                             := 20;
          _wActivateStation                   := StationMask; // this one is important, must be double checked before sending
        END_IF

      E_INSTANCE_STATE.ENABLED:
        CASE _stInstanceState[_nProcess].ProcessProgress
        OF
          E_PROGRESS.PROGRESS_OCCUPIED:       // allow infeed movement
            _tonProcess(IN := FALSE, 
                        PT := DwellTime);

            _stInstanceCtrl[_nProcess].Cmd    := E_INSTANCE_CMD.PROCEED;
        END_CASE

      E_INSTANCE_STATE.WORKING:               // this is for the ProcessByTicket standstill handshake
        CASE _stInstanceState[_nProcess].ProcessProgress
        OF
          E_PROGRESS.PROGRESS_BUSY:           // now every mover has arrived.
            _tonProcess(IN := TRUE, 
                        PT := DwellTime);

            IF (_tonProcess.Q)
            THEN
              memset(ADR(_stProcessData), 0, SIZEOF(_stProcessData));
              _stInstanceCtrl[_nProcess].Cmd := E_INSTANCE_CMD.WORK;
            END_IF

          E_PROGRESS.PROGRESS_OCCUPIED:       // time is fleeting
            _stInstanceCtrl[_nProcess].Cmd  := E_INSTANCE_CMD.FINISH;
        END_CASE

      E_INSTANCE_STATE.FINISH:                // madness takes its toll
        CASE _stInstanceState[_nProcess].ProcessProgress
        OF
          E_PROGRESS.PROGRESS_DONE:
            _tonProcess(IN := FALSE, 
                        PT := DwellTime);

            _stInstanceCtrl[_nProcess].Cmd    := E_INSTANCE_CMD.DISABLE;

            IF (_nProcessConnect > e_instance.INSTANCE_NULL)
            THEN
              memset(ADR(_stProcessData), 0, SIZEOF(_stProcessData));
              _nState                         := 30;
              _wActivateStation               := StationMask; // this one is important, must be double checked before sending
            END_IF
        END_CASE
    END_CASE
END_CASE
CASE _nState OF
  20:
    _nState                                   :=  10;
    TruncMask();

  30:
    _nState                                   := 100;
    TruncMask();
END_CASE
CASE _nState OF

  100:
    //-----------------------------------------------------------------------------  
    // the tickets
    //-----------------------------------------------------------------------------
    // first send the ticket to the Distributor
    _WriteResult                          := _ItfTicketList.AddTailValue(_stProcessData);
    // second write the ticket for the Process
    _stProcessData.nProcessId             := _nProcessConnect;
    _stProcessData.nTargetId              := _nProcessConnectTarget;
    // third send the ticket to the Process
    _WriteResult                          := _ItfTicketList.AddTailValue(_stProcessData);
    //-----------------------------------------------------------------------------
    _nTicketCount                         := _nTicketCount + 1;;
    //-----------------------------------------------------------------------------
    _nState                               := 1000;
END_CASE
CASE _nState OF

  1000:
    IF NOT (_nTicketCountLimit > 0)
    THEN
      _nState                             := 0;
    ELSE
      IF (_nTicketCount < _nTicketCountLimit)
      THEN
        _nState                           := 0;
      END_IF
    END_IF
END_CASE
]]></ST>
    </Implementation>
    <Method Name="BitGet" Id="{57c98de9-b3fd-4f7e-920b-502f6210a0a0}">
      <Declaration><![CDATA[METHOD PUBLIC BitGet : BOOL
VAR_INPUT
  inVal   : T_PROCESS;
  bitNo   : DINT;
END_VAR
VAR
  wConst : T_PROCESS := 1;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ( inVal AND SHL( wConst,TO_SINT(bitNo) MOD TO_INT(SIZEOF(T_PROCESS)*8) ) ) > 0
THEN
  BitGet := TRUE;
ELSE
  BitGet := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="BitSet" Id="{075d513b-2170-4aca-a2e9-2a16152dac6f}">
      <Declaration><![CDATA[METHOD PUBLIC BitSet : T_PROCESS
VAR_INPUT
  inVal   : T_PROCESS;
  bitNo   : DINT;
END_VAR
VAR
  wConst  : T_PROCESS := 1;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[BitSet := inVal OR SHL( wConst,TO_SINT(bitNo) MOD TO_INT(SIZEOF(T_PROCESS)*8) );
]]></ST>
      </Implementation>
    </Method>
