      <LineId Id="42" Count="3" />
      <LineId Id="57" Count="0" />
      <LineId Id="48" Count="2" />
      <LineId Id="64" Count="0" />
      <LineId Id="51" Count="4" />
    </LineIds>
  </POU>
</TcPlcObject>