<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAPPING_in" Id="{ebd5c56c-9a35-4de5-bef9-9829dd0bb032}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAPPING_in
VAR
  sMapping          : STRING;
  bFirstCycle       : BOOL := TRUE;

  TicketListOutput  : U_TICKET_LIST_DATA_OUTPUT;
  TicketListState   : U_TICKET_LIST_STATE;
  InstanceState     : U_INSTANCE_STATE;

  szInstanceState   : ARRAY[1..2] OF UDINT;
  szTicketState     : ARRAY[1..2] OF UDINT;
  szTicketData      : ARRAY[1..2] OF UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF (bFirstCycle)
THEN
  bFirstCycle         := FALSE;
  
  szInstanceState[1]  := SIZEOF(InstanceState);
  szInstanceState[2]  := SIZEOF(GVL_APPLICATION.InstanceState);

  szTicketState[1]    := SIZEOF(TicketListState);
  szTicketState[2]    := SIZEOF(GVL_APPLICATION.TicketListState);

  szTicketData[1]     := SIZEOF(TicketListOutput);
  szTicketData[2]     := SIZEOF(GVL_APPLICATION.TicketListDataOutput);
END_IF
//---------------------------------------------------------------------
IF (SIZEOF(TicketListOutput) <> SIZEOF(GVL_APPLICATION.TicketListDataOutput))
THEN
  sMapping  := 'TicketListOutput sizes DO NOT match';
  RETURN;
END_IF
//---------------------------------------------------------------------
IF (SIZEOF(TicketListState) <> SIZEOF(GVL_APPLICATION.TicketListState))
THEN
  sMapping  := 'TicketListState sizes DO NOT match';
  RETURN;
END_IF
//---------------------------------------------------------------------
IF (SIZEOF(InstanceState) <> SIZEOF(GVL_APPLICATION.InstanceState))
THEN
  sMapping  := 'InstanceState sizes DO NOT match';
  RETURN;
END_IF
//---------------------------------------------------------------------
IF (SIZEOF(AppState) <> SIZEOF(GVL_APPLICATION.AppState))
THEN
  sMapping  := 'AppState sizes DO NOT match';
  RETURN;
END_IF
sMapping    := 'MAPPING ACTIVE';
//-----------------------------------------------------------------------------------------
//       destination,                               source,                size
//-----------------------------------------------------------------------------------------
  memcpy(ADR(GVL_APPLICATION.AppState),             ADR(AppState),         SIZEOF(AppState));

  memcpy(ADR(GVL_APPLICATION.InstanceState),        ADR(InstanceState),    SIZEOF(InstanceState));
  memcpy(ADR(GVL_APPLICATION.TicketListState),      ADR(TicketListState),  SIZEOF(TicketListState));
  memcpy(ADR(GVL_APPLICATION.TicketListDataOutput), ADR(TicketListOutput), SIZEOF(TicketListOutput));
//-----------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------


]]></ST>
    </Implementation>
    <LineIds Name="MAPPING_in">
      <LineId Id="56" Count="0" />
      <LineId Id="2" Count="3" />
      <LineId Id="9" Count="46" />
    </LineIds>
  </POU>
</TcPlcObject>