<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN_APP" Id="{88c725a4-6c17-4e49-9688-89157c201df6}" SpecialFunc="None">
    <Declaration><![CDATA[//---------------------------------------------------------------------------------------------------------------
//
//  HAUD 2026.11.02
//
//  - TowerControl
//
//    - this is the main application switchboard
//
//    - top level transport abstractions are handshaked here:
//    --------------------------------------------
//    - top level transport abstractions
//      - Instances contain the required transport logic
//      - Instances control their assigned ProcessCollector
//      - Instances are controlled in timer based application
//
//
//---------------------------------------------------------------------------------------------------------------
PROGRAM MAIN_APP
VAR
  eInitExternControl  AT %I*    : E_PROGRESS;   // initialization from ExternControl PLC
  eInitXtsTransport   AT %I*    : E_PROGRESS;   // initialization from XtsTransport PLC
  eInit                         : E_PROGRESS;   // local startup

  // message pipeline(s) handling
  eMtrState,
  eMsgState                     : E_MESSAGE_STATE;
  eMtrProgress,
  eMsgProgress                  : E_PROGRESS;
  stMsg                         : ST_Message;
  //-------------------------------------------------------------------------------------------------------------
  tIdleWriteMotion              : TIME := T#5S;
  tIdleWriteApplication         : TIME := T#5S;
  tIdleWriteMetric              : TIME := T#5S;
  tonIdleWriteMotion            : Tc2_Standard.TON;
  tonIdleWriteApplication       : Tc2_Standard.TON;
  tonIdleWriteMetric            : Tc2_Standard.TON;
  //-------------------------------------------------------------------------------------------------------------
  //-------------------------------------------------------------------------------------------------------------
  // testing stuff
  //-------------------------------------------------------------------------------------------------------------
  bStart                        : BOOL;
  Puppets                       : ARRAY[1..MAX_PROCESS] OF fb_DisposableHeros;

  // this is still a subsystem for transport --> dwell time
  {attribute 'displaymode':='bin'}
  wActivateStation              : ARRAY[1..MAX_PROCESS] OF T_PROCESS;
  tProcess                      : ARRAY[1..MAX_PROCESS] OF TIME;
  tonProcess                    : ARRAY[1..MAX_PROCESS] OF Tc2_Standard.TON;


  nIdx                          : E_INSTANCE;

  nState                        : UDINT;    // monolithic case with sequences to run this example

  stWriteTargetInit             : ST_PROCESS_LIST_RESULT;
  stProcessData                 : ST_PROCESS_DATA;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//#################################################################################################################
// Local time; used for timestamps
//#################################################################################################################
GVL_MSG_XTS.fbLocalTime();
GVL_MSG_XTS.sLocalTime                                            := GVL_MSG_XTS.fbLocalTime.LocalTimeString;
GVL_MSG_XTS.dtLocalTime                                           := GVL_MSG_XTS.fbLocalTime.LocalTime;
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
// check for Initialisation from ExternControl
//  - wait for transport layers to be fully started up
//-----------------------------------------------------------------------------------------------------------------
IF NOT (eInitExternControl = E_PROGRESS.PROGRESS_DONE) THEN eInit  := E_PROGRESS.PROGRESS_INVALID; RETURN; END_IF
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
CASE eInit
OF
  //---------------------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_INVALID:
    GVL_APPLICATION.TicketListControl.Cmd         := E_LIST_CTRL.LIST_CTRL_INIT;
    GVL_APPLICATION.YardControl.Cmd               := E_INSTANCE_CMD.NULL;
    eInit                                         := E_PROGRESS.PROGRESS_INIT;
  //---------------------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_INIT:
    IF (GVL_APPLICATION.TicketListState.State = E_LIST_STATE.LIST_STATE_INIT + E_PROGRESS.PROGRESS_DONE)
    THEN
      GVL_APPLICATION.TicketListControl.Cmd       := E_LIST_CTRL.LIST_CTRL_NULL;
      GVL_APPLICATION.YardControl.Cmd             := E_INSTANCE_CMD.INIT;
      eInit                                       := E_PROGRESS.PROGRESS_BUSY;
    END_IF
  //---------------------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_BUSY:
    IF (GVL_APPLICATION.YardState.State = E_INSTANCE_STATE.INIT + E_PROGRESS.PROGRESS_ERROR)
    THEN
      eInit                                       := E_PROGRESS.PROGRESS_ERROR;

    ELSIF (GVL_APPLICATION.YardState.State = E_INSTANCE_STATE.INIT + E_PROGRESS.PROGRESS_DONE)
    THEN
      GVL_APPLICATION.YardControl.Cmd             := E_INSTANCE_CMD.ENABLE;
      eInit                                       := E_PROGRESS.PROGRESS_PREPARE;
    END_IF
  //---------------------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_PREPARE:
    IF (GVL_APPLICATION.YardState.State = E_INSTANCE_STATE.ENABLED + E_PROGRESS.PROGRESS_DONE)
    THEN
      eInit                                       := E_PROGRESS.PROGRESS_OCCUPIED;
    END_IF
  //---------------------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_STARTUP:
    GVL_APPLICATION.YardControl.Cmd               := E_INSTANCE_CMD.WORK;

    IF (GVL_APPLICATION.YardState.State = E_INSTANCE_STATE.WORKING + E_PROGRESS.PROGRESS_DONE)
    THEN
      GVL_APPLICATION.YardControl.Cmd             := E_INSTANCE_CMD.WORK;
      eInit                                       := E_PROGRESS.PROGRESS_DONE;
    END_IF
  //---------------------------------------------------------------------------------------------------------------
  E_PROGRESS.PROGRESS_OCCUPIED:
    tProcess[PROCESS_INFEED]                                := T#3200MS;
    tProcess[PROCESS_ASSEMBLY_01]                           := T#3000MS;
    tProcess[PROCESS_ASSEMBLY_02]                           := T#3000MS;
    tProcess[PROCESS_ASSEMBLY_TEST]                         := T#4300MS;
    tProcess[PROCESS_OUTFEED]                               := T#2200MS;

    wActivateStation[E_INSTANCE.DISTRIBUTOR_INFEED]         := 2#_1111_1111_1111_1111;
    wActivateStation[E_INSTANCE.DISTRIBUTOR_ASSEMBLY_01]    := 2#_1111_1111_1111;
    wActivateStation[E_INSTANCE.DISTRIBUTOR_ASSEMBLY_02]    := 2#_1111_1111;
    wActivateStation[E_INSTANCE.DISTRIBUTOR_ASSEMBLY_TEST]  := 2#_1111_1111_1111;
    wActivateStation[E_INSTANCE.DISTRIBUTOR_OUTFEED]        := 2#_11_1111_1111_1111;

    // string up the puppets
    Puppets[E_INSTANCE.DISTRIBUTOR_INFEED].ProcessId                        := DISTRIBUTOR_INFEED;
    Puppets[E_INSTANCE.DISTRIBUTOR_INFEED].ProcessId_Connect                := PROCESS_INFEED;
    Puppets[E_INSTANCE.DISTRIBUTOR_INFEED].ProcessId_ConnectTarget          := CONTINUOUS_CLEAN;

    Puppets[E_INSTANCE.DISTRIBUTOR_ASSEMBLY_01].ProcessId                   := DISTRIBUTOR_ASSEMBLY_01;     
    Puppets[E_INSTANCE.DISTRIBUTOR_ASSEMBLY_01].ProcessId_Connect           := PROCESS_ASSEMBLY_01;
    Puppets[E_INSTANCE.DISTRIBUTOR_ASSEMBLY_01].ProcessId_ConnectTarget     := DISTRIBUTOR_ASSEMBLY_02;
     
    Puppets[E_INSTANCE.DISTRIBUTOR_ASSEMBLY_02].ProcessId                   := DISTRIBUTOR_ASSEMBLY_02;          
    Puppets[E_INSTANCE.DISTRIBUTOR_ASSEMBLY_02].ProcessId_Connect           := PROCESS_ASSEMBLY_02;
    Puppets[E_INSTANCE.DISTRIBUTOR_ASSEMBLY_02].ProcessId_ConnectTarget     := DISTRIBUTOR_ASSEMBLY_TEST;
          
    Puppets[E_INSTANCE.DISTRIBUTOR_ASSEMBLY_TEST].ProcessId                 := DISTRIBUTOR_ASSEMBLY_TEST;     
    Puppets[E_INSTANCE.DISTRIBUTOR_ASSEMBLY_TEST].ProcessId_Connect         := PROCESS_ASSEMBLY_TEST;
    Puppets[E_INSTANCE.DISTRIBUTOR_ASSEMBLY_TEST].ProcessId_ConnectTarget   := DISTRIBUTOR_CAMERA;
     
    Puppets[E_INSTANCE.DISTRIBUTOR_OUTFEED].ProcessId                       := DISTRIBUTOR_OUTFEED;  
    Puppets[E_INSTANCE.DISTRIBUTOR_OUTFEED].ProcessId_Connect               := PROCESS_OUTFEED;
    Puppets[E_INSTANCE.DISTRIBUTOR_OUTFEED].ProcessId_ConnectTarget         := DISTRIBUTOR_WPC_CLEAN;  

    eInit                                           := E_PROGRESS.PROGRESS_DONE;
END_CASE
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
// /assign dataflow
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
CASE nState OF
  0:
    IF (eInit = E_PROGRESS.PROGRESS_DONE)
    THEN
      nState                                        := 1;
    END_IF

  1:
    // TicketConductor is self initializing after a power cycle
    // DISABLED state is default after successful initialization
    IF (GVL_APPLICATION.TicketConductorState.ProcessState = E_INSTANCE_STATE.DISABLED)
    THEN
      nState                                        := 10;
    END_IF

  10:
    IF bStart
    THEN
      nState                                        := 11;
      FOR nIdx := 1 TO GVL_APPLICATION.MAX_PROCESS
      DO
        Puppets[nIdx](Start                         := FALSE, 
                      DwellTime                     := tProcess[nIdx], 
                      StationMask                   := wActivateStation[nIdx]);

        GVL_APPLICATION.InstanceCtrl[nIdx].Cmd      := E_INSTANCE_CMD.ENABLE;
      END_FOR
    END_IF

  11:
    IF (GVL_APPLICATION.YardState.State = E_INSTANCE_STATE.ENABLED + E_PROGRESS.PROGRESS_DONE)
    THEN
      nState                                        := 20;
    END_IF

  20:
    GVL_APPLICATION.YardControl.Cmd                 := E_INSTANCE_CMD.WORK;
    IF (GVL_APPLICATION.YardState.State = E_INSTANCE_STATE.ENABLED + E_PROGRESS.PROGRESS_DONE)
    THEN
      nState                                        := 100;
    END_IF

  100:
    // the first round of tickets I write here, because the puppets only write tickets AFTER a mover lifecycle
    // why two tickets? --> Master of Puppets (you) can only pull for movers (wActivateStation) in a process,
    //                       if he commands a distributor to send them to him
    //-------------------------------------------------------------------------------------------------------------
    stProcessData.nProcessId                        := E_INSTANCE.DISTRIBUTOR_INFEED;
    stProcessData.nTargetId                         := E_INSTANCE.PROCESS_INFEED;
    stProcessData.wTarget                           := wActivateStation[E_INSTANCE.DISTRIBUTOR_INFEED];

    stWriteTargetInit                               := GVL_APPLICATION.TicketConductorList.AddTailValue(stProcessData);

    stProcessData.nProcessId                        := E_INSTANCE.PROCESS_INFEED;
    stProcessData.nTargetId                         := E_INSTANCE.CONTINUOUS_CLEAN;
    stProcessData.wTarget                           := wActivateStation[E_INSTANCE.DISTRIBUTOR_INFEED];

    stWriteTargetInit                               := GVL_APPLICATION.TicketConductorList.AddTailValue(stProcessData);
    //-------------------------------------------------------------------------------------------------------------
    stProcessData.nProcessId                        := E_INSTANCE.DISTRIBUTOR_ASSEMBLY_01;
    stProcessData.nTargetId                         := E_INSTANCE.PROCESS_ASSEMBLY_01;
    stProcessData.wTarget                           := wActivateStation[E_INSTANCE.DISTRIBUTOR_ASSEMBLY_01];

    stWriteTargetInit                               := GVL_APPLICATION.TicketConductorList.AddTailValue(stProcessData);

    stProcessData.nProcessId                        := E_INSTANCE.PROCESS_ASSEMBLY_01;
    stProcessData.nTargetId                         := E_INSTANCE.DISTRIBUTOR_ASSEMBLY_02;
    stProcessData.wTarget                           := wActivateStation[E_INSTANCE.DISTRIBUTOR_ASSEMBLY_01];

    stWriteTargetInit                               := GVL_APPLICATION.TicketConductorList.AddTailValue(stProcessData);
    //-------------------------------------------------------------------------------------------------------------
    stProcessData.nProcessId                        := E_INSTANCE.DISTRIBUTOR_ASSEMBLY_02;
    stProcessData.nTargetId                         := E_INSTANCE.PROCESS_ASSEMBLY_02;
    stProcessData.wTarget                           := wActivateStation[E_INSTANCE.DISTRIBUTOR_ASSEMBLY_02];

    stWriteTargetInit                               := GVL_APPLICATION.TicketConductorList.AddTailValue(stProcessData);

    stProcessData.nProcessId                        := E_INSTANCE.PROCESS_ASSEMBLY_02;
    stProcessData.nTargetId                         := E_INSTANCE.DISTRIBUTOR_ASSEMBLY_TEST;
    stProcessData.wTarget                           := wActivateStation[E_INSTANCE.DISTRIBUTOR_ASSEMBLY_02];

    stWriteTargetInit                               := GVL_APPLICATION.TicketConductorList.AddTailValue(stProcessData);
    //-------------------------------------------------------------------------------------------------------------
    stProcessData.nProcessId                        := E_INSTANCE.DISTRIBUTOR_ASSEMBLY_TEST;
    stProcessData.nTargetId                         := E_INSTANCE.PROCESS_ASSEMBLY_TEST;
    stProcessData.wTarget                           := wActivateStation[E_INSTANCE.DISTRIBUTOR_ASSEMBLY_TEST];

    stWriteTargetInit                               := GVL_APPLICATION.TicketConductorList.AddTailValue(stProcessData);

    stProcessData.nProcessId                        := E_INSTANCE.PROCESS_ASSEMBLY_TEST;
    stProcessData.nTargetId                         := E_INSTANCE.DISTRIBUTOR_CAMERA;
    stProcessData.wTarget                           := wActivateStation[E_INSTANCE.DISTRIBUTOR_ASSEMBLY_TEST];

    stWriteTargetInit                               := GVL_APPLICATION.TicketConductorList.AddTailValue(stProcessData);
    //-------------------------------------------------------------------------------------------------------------
    stProcessData.nProcessId                        := E_INSTANCE.DISTRIBUTOR_OUTFEED;
    stProcessData.nTargetId                         := E_INSTANCE.PROCESS_OUTFEED;
    stProcessData.wTarget                           := wActivateStation[E_INSTANCE.DISTRIBUTOR_OUTFEED];

    stWriteTargetInit                               := GVL_APPLICATION.TicketConductorList.AddTailValue(stProcessData);

    stProcessData.nProcessId                        := E_INSTANCE.PROCESS_OUTFEED;
    stProcessData.nTargetId                         := E_INSTANCE.DISTRIBUTOR_WPC_CLEAN;
    stProcessData.wTarget                           := wActivateStation[E_INSTANCE.DISTRIBUTOR_OUTFEED];

    stWriteTargetInit                               := GVL_APPLICATION.TicketConductorList.AddTailValue(stProcessData);

    nState                                          := 200;


  200:
    FOR nIdx := 1 TO GVL_APPLICATION.MAX_PROCESS
    DO
      Puppets[nIdx](Start                           := bStart, 
                    DwellTime                       := tProcess[nIdx], 
                    StationMask                     := wActivateStation[nIdx]);
    END_FOR

    IF NOT bStart THEN nState := 300; END_IF



  300:
    FOR nIdx := 1 TO GVL_APPLICATION.MAX_PROCESS
    DO
      GVL_APPLICATION.InstanceCtrl[nIdx].Cmd        := E_INSTANCE_CMD.INIT; 
    END_FOR
    nState                                          := 400;

  400:
    GVL_APPLICATION.TicketConductorCtrl.Cmd         := E_INSTANCE_CMD.DISABLE;
    bStart                                          := FALSE;
    nState                                          := 0;

END_CASE
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
FOR nIdx := 1 TO GVL_APPLICATION.MAX_PROCESS
DO
  Puppets[nIdx].ProcessId                           :=   nIdx;
  Puppets[nIdx].InstanceCtrl                        REF= GVL_APPLICATION.InstanceCtrl;
  Puppets[nIdx].InstanceState                       REF= GVL_APPLICATION.InstanceState;
  Puppets[nIdx].TicketLinkedList                    :=   GVL_APPLICATION.TicketConductorList;
END_FOR
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
GVL_APPLICATION.TicketConductor.TicketLinkedList    :=   GVL_APPLICATION.TicketConductorList;
GVL_APPLICATION.TicketConductor.Ctrl                REF= GVL_APPLICATION.TicketConductorCtrl;
GVL_APPLICATION.TicketConductor.State               REF= GVL_APPLICATION.TicketConductorState;

GVL_APPLICATION.TicketConductor.CyclicListCtrl      REF= GVL_APPLICATION.TicketListControl;
GVL_APPLICATION.TicketConductor.CyclicListState     REF= GVL_APPLICATION.TicketListState;
GVL_APPLICATION.TicketConductor.CyclicListData      REF= GVL_APPLICATION.TicketListDataInput;
GVL_APPLICATION.TicketConductor();
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------




//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
//#################################################################################################################
//  /logging
//    - all life is problem solving
//#################################################################################################################
GVL_MSG_XTS.TransportMessageData.Ctrl               REF= GVL_MSG_XTS.TransportMessageCtrl;
GVL_MSG_XTS.TransportMessageData.State              REF= GVL_MSG_XTS.TransportMessageState;
GVL_MSG_XTS.TransportMessageData.MessageIndex       REF= GVL_MSG_XTS.MessageTransportIndex;
GVL_MSG_XTS.TransportMessageData.ErrorIndex         REF= GVL_MSG_XTS.MessageTransportError;
GVL_MSG_XTS.TransportMessageData.DirRoot            :=   ADR(GVL_MSG_XTS.LOG_DIR);
GVL_MSG_XTS.TransportMessageData.FileRoot           :=   ADR(GVL_MSG_XTS.LOG_FILE);
GVL_MSG_XTS.TransportMessageData.MsgList            :=   ADR(GVL_MSG_XTS.TransportMessages);
GVL_MSG_XTS.TransportMessageData.LocalTime          :=   ADR(GVL_MSG_XTS.dtLocalTime);
GVL_MSG_XTS.TransportMessageData();
eMsgState                                           :=   f_GetState   (GVL_MSG_XTS.TransportMessageState.State);
eMsgProgress                                        :=   f_GetProgress(GVL_MSG_XTS.TransportMessageState.State);

CASE eMsgState
OF
  E_MESSAGE_STATE.MSG_STATE_NULL:
    CASE eMsgProgress
    OF
      E_PROGRESS.PROGRESS_INVALID,
      E_PROGRESS.PROGRESS_DONE:
        IF (GVL_MSG_XTS.MessageTransportIndex > GVL_MSG_XTS.MAX_MESSAGE/101) OR
           (GVL_MSG_XTS.MessageTransportError > 0)
        THEN
          GVL_MSG_XTS.TransportMessageCtrl.Cmd      := E_MESSAGE_CTRL.MSG_CTRL_WRITE;
        ELSE
          tonIdleWriteMotion(IN := TRUE, PT:= tIdleWriteMotion);
          IF (tonIdleWriteMotion.Q)
          THEN
            GVL_MSG_XTS.TransportMessageCtrl.Cmd    := E_MESSAGE_CTRL.MSG_CTRL_WRITE;
          END_IF
        END_IF
    END_CASE

  E_MESSAGE_STATE.MSG_STATE_WRITE:
    CASE eMsgProgress
    OF
      E_PROGRESS.PROGRESS_ERROR,
      E_PROGRESS.PROGRESS_DONE:
          tonIdleWriteMotion(IN := FALSE, PT:= tIdleWriteMotion);
        GVL_MSG_XTS.TransportMessageCtrl.Cmd        := E_MESSAGE_CTRL.MSG_CTRL_NULL;
    END_CASE

ELSE
    CASE eMsgProgress
    OF
      E_PROGRESS.PROGRESS_DONE:
          tonIdleWriteMotion(IN := FALSE, PT:= tIdleWriteMotion);
        GVL_MSG_XTS.TransportMessageCtrl.Cmd        := E_MESSAGE_CTRL.MSG_CTRL_NULL;
    END_CASE
END_CASE
//#################################################################################################################
// /application logging
//#################################################################################################################
GVL_MSG_XTS.ApplicationMessageData.Ctrl             REF= GVL_MSG_XTS.ApplicationMessageCtrl;
GVL_MSG_XTS.ApplicationMessageData.State            REF= GVL_MSG_XTS.ApplicationMessageState;

GVL_MSG_XTS.ApplicationMessageData.MessageIndex     REF= GVL_MSG_XTS.MessageApplicationIndex;
GVL_MSG_XTS.ApplicationMessageData.ErrorIndex       REF= GVL_MSG_XTS.MessageApplicationError;

GVL_MSG_XTS.ApplicationMessageData.DirRoot          :=   ADR(GVL_MSG_XTS.LOG_DIR);
GVL_MSG_XTS.ApplicationMessageData.FileRoot         :=   ADR(GVL_MSG_XTS.LOG_FILE_APP);
GVL_MSG_XTS.ApplicationMessageData.MsgList          :=   ADR(GVL_MSG_XTS.ApplicationMessages);
GVL_MSG_XTS.ApplicationMessageData.LocalTime        :=   ADR(GVL_MSG_XTS.dtLocalTime);

GVL_MSG_XTS.ApplicationMessageData();

eMsgState                                           := f_GetState   (GVL_MSG_XTS.ApplicationMessageState.State);
eMsgProgress                                        := f_GetProgress(GVL_MSG_XTS.ApplicationMessageState.State);


CASE eMsgState
OF
  E_MESSAGE_STATE.MSG_STATE_NULL:
    CASE eMsgProgress
    OF
      E_PROGRESS.PROGRESS_INVALID:
        IF (GVL_MSG_XTS.MessageApplicationIndex > GVL_MSG_XTS.MAX_MESSAGE/13) OR
           (GVL_MSG_XTS.MessageApplicationError > 0)
        THEN
          GVL_MSG_XTS.ApplicationMessageCtrl.Cmd    := E_MESSAGE_CTRL.MSG_CTRL_WRITE;
        ELSE
          tonIdleWriteApplication(IN := TRUE, PT:= tIdleWriteApplication);
          IF (tonIdleWriteApplication.Q)
          THEN
            GVL_MSG_XTS.ApplicationMessageCtrl.Cmd  := E_MESSAGE_CTRL.MSG_CTRL_WRITE;
          END_IF
        END_IF
    END_CASE

  E_MESSAGE_STATE.MSG_STATE_WRITE:
    CASE eMsgProgress
    OF
      E_PROGRESS.PROGRESS_ERROR,
      E_PROGRESS.PROGRESS_DONE:
        tonIdleWriteApplication(IN := FALSE, PT:= tIdleWriteApplication);
        GVL_MSG_XTS.ApplicationMessageCtrl.Cmd      := E_MESSAGE_CTRL.MSG_CTRL_NULL;
    END_CASE

ELSE
    CASE eMsgProgress
    OF
      E_PROGRESS.PROGRESS_DONE:
        tonIdleWriteApplication(IN := FALSE, PT:= tIdleWriteApplication);
        GVL_MSG_XTS.ApplicationMessageCtrl.Cmd      := E_MESSAGE_CTRL.MSG_CTRL_NULL;
    END_CASE
END_CASE
//#################################################################################################################
// logging/
//#################################################################################################################
//#################################################################################################################
//  /Transport Metrics
//#################################################################################################################
GVL_MSG_XTS.MetricsMessageData.Ctrl                 REF= GVL_MSG_XTS.MetricsMessageCtrl;
GVL_MSG_XTS.MetricsMessageData.State                REF= GVL_MSG_XTS.MetricsMessageState;

GVL_MSG_XTS.MetricsMessageData.MessageIndex         REF= GVL_MSG_XTS.MessageMetricsIndex;
GVL_MSG_XTS.MetricsMessageData.ErrorIndex           REF= GVL_MSG_XTS.MessageMetricsError;

GVL_MSG_XTS.MetricsMessageData.DirRoot              :=   ADR(GVL_MSG_XTS.LOG_DIR);
GVL_MSG_XTS.MetricsMessageData.FileRoot             :=   ADR(GVL_MSG_XTS.LOG_FILE_METRIC);
GVL_MSG_XTS.MetricsMessageData.MsgList              :=   ADR(GVL_MSG_XTS.MetricsMessages);
GVL_MSG_XTS.MetricsMessageData.LocalTime            :=   ADR(GVL_MSG_XTS.dtLocalTime);

GVL_MSG_XTS.MetricsMessageData();

eMtrState                                           := f_GetState   (GVL_MSG_XTS.MetricsMessageState.State);
eMtrProgress                                        := f_GetProgress(GVL_MSG_XTS.MetricsMessageState.State);

CASE eMtrState
OF
  E_MESSAGE_STATE.MSG_STATE_NULL:
    CASE eMtrProgress
    OF
      E_PROGRESS.PROGRESS_INVALID:
        IF (GVL_MSG_XTS.MessageMetricsIndex > GVL_MSG_XTS.MAX_MESSAGE/5) OR
           (GVL_MSG_XTS.MessageMetricsError > 0)
        THEN
          GVL_MSG_XTS.MetricsMessageCtrl.Cmd        := E_MESSAGE_CTRL.MSG_CTRL_WRITE;
        ELSE
          tonIdleWriteMetric(IN := TRUE, PT:= tIdleWriteMetric);
          IF (tonIdleWriteMetric.Q)
          THEN
            GVL_MSG_XTS.MetricsMessageCtrl.Cmd      := E_MESSAGE_CTRL.MSG_CTRL_WRITE;
          END_IF
        END_IF
    END_CASE

  E_MESSAGE_STATE.MSG_STATE_WRITE:
    CASE eMtrProgress
    OF
      E_PROGRESS.PROGRESS_ERROR,
      E_PROGRESS.PROGRESS_DONE:
        tonIdleWriteMetric(IN := FALSE, PT:= tIdleWriteMetric);
        GVL_MSG_XTS.MetricsMessageCtrl.Cmd          := E_MESSAGE_CTRL.MSG_CTRL_NULL;
    END_CASE
ELSE
    CASE eMtrProgress
    OF
      E_PROGRESS.PROGRESS_DONE:
        tonIdleWriteMetric(IN := FALSE, PT:= tIdleWriteMetric);
        GVL_MSG_XTS.MetricsMessageCtrl.Cmd          := E_MESSAGE_CTRL.MSG_CTRL_NULL;
    END_CASE
END_CASE
//#################################################################################################################
//  Transport Metrics/
//#################################################################################################################
//#################################################################################################################
//#################################################################################################################
]]></ST>
    </Implementation>
    <LineIds Name="MAIN_APP">
      <LineId Id="732" Count="62" />
      <LineId Id="1059" Count="0" />
      <LineId Id="1062" Count="0" />
