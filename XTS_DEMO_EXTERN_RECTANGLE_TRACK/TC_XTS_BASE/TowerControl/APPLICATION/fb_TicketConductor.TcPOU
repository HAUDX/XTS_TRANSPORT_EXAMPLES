<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fb_TicketConductor" Id="{b2975459-610b-4622-ae2f-021df5bebfac}" SpecialFunc="None">
    <Declaration><![CDATA[//---------------------------------------------------------------------------------------------------------------
//
//  HAUD 2026.11.07
//
//  - fb_TicketConductor
//  -----------------------------
//  - detects new entry in the linked list
//    - forwards the received entry to cyclic linked list
//    - cyclic linked list is then sending the ticket abroad.
//
//  - Ctrl / State for you to use (uses instance ctrl/state pair)
//    - this is simply a ENABLE / DISABLE class
//    - the input list is simply checked for (count > 0)
//  - this conductor has no transport process
//  - this conductor is used for sending tickets to cyclic list strucutres
//---------------------------------------------------------------------------------------------------------------
FUNCTION_BLOCK fb_TicketConductor
VAR
  _nConductor             : E_INSTANCE := E_INSTANCE.INSTANCE_CONDUCTOR; // msg device identifier, in case you instantiate more than one conductor
  _stCtrl                 : REFERENCE TO ST_INSTANCE_CTRL;
  _stState                : REFERENCE TO ST_INSTANCE_STATE;

  _eCmd,
  _eCmdOld                : E_INSTANCE_CMD;       // commands for local state machine
  _eStateInstance         : E_INSTANCE_STATE;     // local state machine for infeed procedure

  _eResult                : E_PROGRESS;           // result for methods
  _eStateProgress         : E_PROGRESS;           // substate for local state machine

  _eInit                  : E_PROGRESS;           // startup
  _eCheck                 : E_INSTANCE_CHECK;     // pointer checks

  // the outbox
  _stListCtrl             : REFERENCE TO ST_LIST_CTRL;
  _stListState            : REFERENCE TO ST_LIST_STATE;
  _stListDataInput        : REFERENCE TO ST_LIST_NODE_DATA;

  // the inbox
  _ItfTicketList          : I_Process_LinkedList;
  _ResultTicketList       : ST_PROCESS_LIST_RESULT;   // internal list results
  _DeleteResult           : ST_PROCESS_LIST_RESULT;   // last job executed

  _stMsg                  : ST_Message;
  _MessageLevel           : E_MessageType := E_MessageType.eMessageInfo;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
// check pointer and interface
// set message device identification
//-----------------------------------------------------------------------------
IF NOT Check() THEN 
  RETURN; 
END_IF
//-----------------------------------------------------------------------------
// check command
//-----------------------------------------------------------------------------
_eCmd                                         := _stCtrl.Cmd;
IF (_eCmd <> _eCmdOld)
THEN
  CASE _eCmd
  OF
    E_INSTANCE_CMD.INIT:
      _eStateInstance                         := E_INSTANCE_STATE.NULL;
      _eStateProgress                         := E_PROGRESS.PROGRESS_INIT;
  END_CASE
  CmdLog();
  _eCmdOld                                    := _eCmd;
END_IF
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
// state machine for ProcessConductor work
//-----------------------------------------------------------------------------
CASE _eStateInstance
OF
  E_INSTANCE_STATE.NULL:
    // first cycle startup
    _eInit                                    := E_PROGRESS.PROGRESS_INVALID;
    _eStateProgress                           := E_PROGRESS.PROGRESS_INIT;
    _eStateInstance                           := E_INSTANCE_STATE.INIT;


  E_INSTANCE_STATE.INIT:
    //-------------------------------------------------------------------------
    CASE _eStateProgress
    OF
    // E_INSTANCE_STATE.INIT:
    //-------------------------------------------------------------------------
      E_PROGRESS.PROGRESS_INIT:
        IF (_ItfTicketList <> 0)
        THEN
          _eStateProgress                     := E_PROGRESS.PROGRESS_BUSY;
        END_IF
    // E_INSTANCE_STATE.INIT:
    //-------------------------------------------------------------------------
      E_PROGRESS.PROGRESS_BUSY:
        IF _ItfTicketList.InitList()
        THEN
          IF (_stListState.Init <> E_PROGRESS.PROGRESS_DONE)
          THEN
            _stListCtrl.Cmd                   := E_LIST_CTRL.LIST_CTRL_NULL;
            _eStateProgress                   := E_PROGRESS.PROGRESS_PREPARE;
          ELSE
            _eInit                            := E_PROGRESS.PROGRESS_DONE;
  
            _eStateInstance                   := E_INSTANCE_STATE.DISABLED;
            _eStateProgress                   := E_PROGRESS.PROGRESS_BUSY;
          END_IF
        ELSE
          _eStateProgress                     := E_PROGRESS.PROGRESS_ERROR;
        END_IF
    // E_INSTANCE_STATE.INIT:
    //-------------------------------------------------------------------------
      E_PROGRESS.PROGRESS_PREPARE:
        _stListCtrl.Cmd                       := E_LIST_CTRL.LIST_CTRL_INIT;

        IF (_stListState.Init = E_PROGRESS.PROGRESS_DONE)
        THEN
          _stListCtrl.Cmd                     := E_LIST_CTRL.LIST_CTRL_NULL;
          _eStateInstance                     := E_INSTANCE_STATE.DISABLED;
          _eStateProgress                     := E_PROGRESS.PROGRESS_BUSY;
          _eInit                              := E_PROGRESS.PROGRESS_DONE;

        ELSIF (_stListState.Init = E_PROGRESS.PROGRESS_ERROR)
        THEN
          _eStateProgress                     := E_PROGRESS.PROGRESS_ERROR;
        END_IF
    END_CASE
END_CASE
//-----------------------------------------------------------------------------
// DISABLED:
//  - clear local list result data
//  - wait for enable from the outside
//-----------------------------------------------------------------------------
CASE _eStateInstance
OF
  E_INSTANCE_STATE.DISABLED:
    //-------------------------------------------------------------------------
    CASE _eStateProgress
    OF
      E_PROGRESS.PROGRESS_BUSY:
        CASE _eCmd
        OF
          E_INSTANCE_CMD.ENABLE:              // turn it on!!
            _stListCtrl.Cmd                   := E_LIST_CTRL.LIST_CTRL_NULL;

            _eStateInstance                   := E_INSTANCE_STATE.DETECTION;
            _eStateProgress                   := E_PROGRESS.PROGRESS_BUSY;
  
            IF (_MessageLevel > E_MessageType.eMessageInfo)
            THEN
              _stMsg.eType                    := E_MessageType.eMessageVerbose;
              _stMsg.eSubdevice               := e_Subdevice.Instance_ProcessConductor;
              _stMsg.iErrorNumber             := 0;
              _stMsg.sText                    := concat(TO_STRING(_eStateInstance), ': ');
              _stMsg.sText                    := concat(_stMsg.sText, TO_STRING(_eStateProgress));
              f_MessageSet(_stMsg);
            END_IF
        END_CASE
    END_CASE
END_CASE
//-----------------------------------------------------------------------------
// DETECTION: 
//  - check inked list and GetHead()
//  - copy job data
//  - switch on process
//-----------------------------------------------------------------------------
CASE _eStateInstance
OF
  E_INSTANCE_STATE.DETECTION:
    //-------------------------------------------------------------------------
    CASE _eStateProgress
    OF
      E_PROGRESS.PROGRESS_BUSY:
        IF (_eCmd = E_INSTANCE_CMD.DISABLE)
        THEN
          _eStateInstance                     := E_INSTANCE_STATE.DISABLED;
          _eStateProgress                     := E_PROGRESS.PROGRESS_BUSY;
  
        ELSIF (_ItfTicketList.Count > 0)
        THEN
          // get new job order for my process
          // the list results carries information about who and where
          _ResultTicketList                   := _ItfTicketList.GetHead();
  
          IF (_ResultTicketList.wState <> 0)
          THEN
            // error in list results must not appear
            // if you land here, there is somethng wrong with the initialization or configuration of the linked list
            _eStateProgress                   := E_PROGRESS.PROGRESS_ERROR;
  
            _stMsg.eType                      := E_MessageType.eMessageError;
            _stMsg.eSubdevice                 := e_Subdevice.Instance_ProcessConductor;
            _stMsg.iErrorNumber               := _ResultTicketList.wState;
            _stMsg.sText                      := concat(TO_STRING(_eStateInstance), ': _ResultTicketList.wState: ');
            _stMsg.sText                      := concat(_stMsg.sText, TO_STRING(_eStateProgress));
            f_MessageSet(_stMsg);
  
          ELSE
            IF (_MessageLevel > E_MessageType.eMessageError)
            THEN
              _stMsg.eType                    := E_MessageType.eMessageInfo;
              _stMsg.eSubdevice               := e_Subdevice.Instance_ProcessConductor;
              _stMsg.iErrorNumber             := _ResultTicketList.stData.wTarget;
              _stMsg.sText                    := concat(TO_STRING(_eStateInstance), ': ');
              _stMsg.sText                    := concat(_stMsg.sText, '_ResultTicketList.stData.wTarget: ');
              _stMsg.sText                    := concat(_stMsg.sText, BitsToString(_ResultTicketList.stData.wTarget));
              f_MessageSet(_stMsg);
            END_IF
  
            IF (_ResultTicketList.stData.wTarget > 0)
            THEN
              _eStateProgress                 := E_PROGRESS.PROGRESS_PREPARE;
  
              IF (_MessageLevel > E_MessageType.eMessageEmpty)
              THEN
                _stMsg.eType                  := E_MessageType.eMessageBatch;
                _stMsg.eSubdevice             := e_Subdevice.Instance_ProcessConductor;
                _stMsg.iErrorNumber           := 0;
                _stMsg.sText                  := concat(TO_STRING(_eStateProgress), ': ');
                _stMsg.sText                  := concat(_stMsg.sText, TO_STRING(e_message_batch.MSG_BATCH_JOB_STARTED));
                f_MessageSet(_stMsg);
              END_IF
            ELSE
              _ResultTicketList               := _ItfTicketList.RemoveHeadValue();

              IF (_ResultTicketList.wState <> 0)
              THEN
                _stMsg.eType                  := E_MessageType.eMessageError;
                _stMsg.eSubdevice             := e_Subdevice.Instance_ProcessConductor;
                _stMsg.iErrorNumber           := _ResultTicketList.wState;
                _stMsg.sText                  := concat(TO_STRING(_eStateProgress), ': _ResultTicketList.wState: ');
                _stMsg.sText                  := concat(_stMsg.sText, BitsToString(_ResultTicketList.wState));
                f_MessageSet(_stMsg);

                _eStateProgress               := E_PROGRESS.PROGRESS_ERROR;
              END_IF
            END_IF
  
            // check target mask for entries
            IF NOT (_ResultTicketList.stData.wTarget > 0)
            THEN
              _stMsg.eType                    := E_MessageType.eMessageWarning;
              _stMsg.eSubdevice               := e_Subdevice.Process_LinkedList_CheckData;
              _stMsg.iErrorNumber             := 666;
              _stMsg.sText                    := concat(TO_STRING(_eStateInstance), ': ');
              _stMsg.sText                    := concat(_stMsg.sText, '_ResultTicketList.stData.wTarget: ');
              _stMsg.sText                    := concat(_stMsg.sText, BitsToString(_ResultTicketList.stData.wTarget));
              f_MessageSet(_stMsg);
            END_IF
          END_IF
        END_IF

      E_PROGRESS.PROGRESS_PREPARE:
        // check process target plausibility
        IF NOT (_ResultTicketList.stData.nProcessId > 0) OR
           NOT (_ResultTicketList.stData.nProcessId < E_INSTANCE.INSTANCE_MAX)
        THEN
          _ResultTicketList                   := _ItfTicketList.RemoveHeadValue();
  
          IF (_ResultTicketList.wState <> 0)
          THEN
            _stMsg.eType                      := E_MessageType.eMessageError;
            _stMsg.eSubdevice                 := e_Subdevice.Instance_ProcessConductor;
            _stMsg.iErrorNumber               := _ResultTicketList.wState;
            _stMsg.sText                      := concat(TO_STRING(_eStateProgress), ': _ResultTicketList.wState: ');
            _stMsg.sText                      := concat(_stMsg.sText, BitsToString(_ResultTicketList.wState));
            f_MessageSet(_stMsg);

            _eStateProgress                   := E_PROGRESS.PROGRESS_ERROR;
          END_IF

          _stMsg.eType                        := E_MessageType.eMessageError;
          _stMsg.eSubdevice                   := e_Subdevice.Process_LinkedList_CheckData;
          _stMsg.iErrorNumber                 := 6666;
          _stMsg.sText                        := concat(TO_STRING(_eStateInstance), ': ');
          _stMsg.sText                        := concat(_stMsg.sText, '_ResultTicketList.stData.nProcessId: ');
          _stMsg.sText                        := concat(_stMsg.sText, TO_STRING(_ResultTicketList.stData.nProcessId));
          f_MessageSet(_stMsg);
  
        ELSE
          IF (_MessageLevel > E_MessageType.eMessageInfo)
          THEN
            _stMsg.eType                      := E_MessageType.eMessageVerbose;
            _stMsg.eSubdevice                 := e_Subdevice.Instance_ProcessConductor;
            _stMsg.iErrorNumber               := _ResultTicketList.stData.nProcessId;
            _stMsg.sText                      := concat(TO_STRING(_eStateInstance), ': _ResultTicketList.stData.nProcessId: ');
            _stMsg.sText                      := concat(_stMsg.sText, TO_STRING(_ResultTicketList.stData.nProcessId));
            f_MessageSet(_stMsg);
          END_IF

          _stListDataInput.ProcessData        := _ResultTicketList.stData;
          _DeleteResult                       := _ItfTicketList.RemoveHeadValue();
  
          IF (_DeleteResult.wState = 0)
          THEN
            _eStateInstance                   := E_INSTANCE_STATE.WORKING;
            _eStateProgress                   := E_PROGRESS.PROGRESS_BUSY;
          ELSE
            _stMsg.eType                      := E_MessageType.eMessageError;
            _stMsg.eSubdevice                 := e_Subdevice.Instance_ProcessConductor;
            _stMsg.iErrorNumber               := _DeleteResult.wState;
            _stMsg.sText                      := concat(TO_STRING(_eStateProgress), ': _DeleteResult.wState: ');
            _stMsg.sText                      := concat(_stMsg.sText, BitsToString(_DeleteResult.wState));
            f_MessageSet(_stMsg);

            _eStateProgress                   := E_PROGRESS.PROGRESS_ERROR;
          END_IF
        END_IF
    END_CASE
END_CASE
//-----------------------------------------------------------------------------
// WORKING
//  - Add ticket in target list
//  - check and log
//  - transition to finish
//-----------------------------------------------------------------------------
CASE _eStateInstance
OF
  E_INSTANCE_STATE.WORKING:
    //-------------------------------------------------------------------------
    CASE _eStateProgress
    OF
      E_PROGRESS.PROGRESS_BUSY:
        _stListCtrl.Cmd                       := E_LIST_CTRL.LIST_CTRL_ADD_TAIL;

        IF (_stListState.State = E_LIST_STATE.LIST_STATE_ADD_TAIL + E_PROGRESS.PROGRESS_DONE)
        THEN
          _stListCtrl.Cmd                     := E_LIST_CTRL.LIST_CTRL_NULL;
          _eStateInstance                     := E_INSTANCE_STATE.FINISH;
          _eStateProgress                     := E_PROGRESS.PROGRESS_BUSY;

        ELSIF (_stListState.State = E_LIST_STATE.LIST_STATE_ADD_TAIL + E_PROGRESS.PROGRESS_ERROR)
        THEN
          _eStateProgress                     := E_PROGRESS.PROGRESS_ERROR;
        END_IF
    END_CASE
END_CASE
//-----------------------------------------------------------------------------
// FINISH:
//-----------------------------------------------------------------------------
CASE _eStateInstance
OF
  E_INSTANCE_STATE.FINISH:
    //-------------------------------------------------------------------------
    CASE _eStateProgress
    OF
      E_PROGRESS.PROGRESS_BUSY:
        _eStateProgress                       := E_PROGRESS.PROGRESS_DONE;
    END_CASE
    // E_INSTANCE_STATE.FINISH:
    //-------------------------------------------------------------------------
    CASE _eStateProgress
    OF
      E_PROGRESS.PROGRESS_DONE:
        _eStateInstance                       := E_INSTANCE_STATE.DISABLED;
        _eStateProgress                       := E_PROGRESS.PROGRESS_BUSY;
    END_CASE
END_CASE
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
_stState.ProcessIdentity                      := _nConductor;
_stState.ProcessState                         := _eStateInstance;
_stState.ProcessProgress                      := _eStateProgress;
_stState.QueueProcessCount                    := TO_UINT(_ItfTicketList.Count);
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
]]></ST>
    </Implementation>
    <Method Name="BitGet" Id="{c2d83cf2-dbce-411d-a81b-1737586284e7}">
      <Declaration><![CDATA[METHOD PUBLIC BitGet : BOOL
VAR_INPUT
  inVal   : T_PROCESS;
  bitNo   : DINT;
END_VAR
VAR
  wConst : T_PROCESS := 1;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ( inVal AND SHL( wConst,TO_SINT(bitNo) MOD TO_INT(SIZEOF(T_PROCESS)*8) ) ) > 0
THEN
  BitGet := TRUE;
ELSE
  BitGet := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="BitsToString" Id="{f72cba2b-f8e8-4a05-bc02-5475239bcff5}">
      <Declaration><![CDATA[METHOD BitsToString : STRING(SIZEOF(T_PROCESS)*8) // T_PROCESS to string
VAR_INPUT
  inVal       : T_PROCESS;
END_VAR
VAR
  _nx         : DINT;
  _str        : STRING(SIZEOF(T_PROCESS)*8);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR _nx := ((SIZEOF(inVal)*8)) TO 1 BY(-1)
DO
  IF (BitGet(inVal, _nx-1))
  THEN
    _str     := concat(_str, '1');
  ELSE
    _str     := concat(_str, '0');
  END_IF
END_FOR

BitsToString := _str;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Check" Id="{cb3f11a1-f1a7-4ee3-af44-3681fdcfcb4b}">
      <Declaration><![CDATA[METHOD Check  : BOOL // call this method in the extending/inheriting class
VAR_INST
  _idx        : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
// pointer checks
//-----------------------------------------------------------------------------
IF NOT __ISVALIDREF(_stCtrl)
THEN
  _eCheck                 := E_INSTANCE_CHECK.INVALID_INSTANCE_CONTROL_REFERENCE;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_stState)
THEN
  _eCheck                 := E_INSTANCE_CHECK.INVALID_INSTANCE_STATE_REFERENCE;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_stListCtrl)
THEN
  _eCheck                 := E_INSTANCE_CHECK.CTRL_CYCLIC_LIST_REFERENCE_INVALID;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_stListState)
THEN
  _eCheck                 := E_INSTANCE_CHECK.STATE_CYCLIC_LIST_REFERENCE_INVALID;
  RETURN;
END_IF

IF NOT __ISVALIDREF(_stListDataInput)
THEN
  _eCheck                 := E_INSTANCE_CHECK.DATA_CYCLIC_LIST_REFERENCE_INVALID;
  RETURN;
END_IF

IF NOT (_ItfTicketList <> 0)
THEN
  _eCheck                 := E_INSTANCE_CHECK.TICKET_LIST_ITF_INVALID;
  RETURN;
END_IF

//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
// set message device
//-----------------------------------------------------------------------------
_stMsg.eDevice            := e_Device.Conductor + TO_UINT(_nConductor);
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
_eCheck                   := E_INSTANCE_CHECK.CHECK_DONE;
Check                     := TRUE;


]]></ST>
      </Implementation>
    </Method>
    <Method Name="CmdLog" Id="{3965707d-6687-42ea-8ffe-d947bf5ebb46}">
      <Declaration><![CDATA[METHOD CmdLog
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF (_MessageLevel > E_MessageType.eMessageError)
THEN
  _stMsg.eSubdevice       := e_Subdevice.Instance_ProcessConductor;
  _stMsg.iErrorNumber     := 0;
  _stMsg.sText            := concat('E_INSTANCE_CMD', '.');
  _stMsg.sText            := concat(_stMsg.sText, TO_STRING(_eCmd));
  f_MessageSet(_stMsg);
END_IF
]]></ST>
      </Implementation>
    </Method>
