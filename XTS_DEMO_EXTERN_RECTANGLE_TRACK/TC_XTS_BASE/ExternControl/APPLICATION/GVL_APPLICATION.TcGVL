<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_APPLICATION" Id="{ef5c8ee7-19c1-4689-9600-6bba8e125d3a}">
    <Declaration><![CDATA[VAR_GLOBAL CONSTANT
  MAX_PROCESS       : E_INSTANCE    := E_INSTANCE.DISTRIBUTOR_WPC_CLEAN;
END_VAR
{attribute 'qualified_only'}
VAR_GLOBAL
  //-----------------------------------------------------------------------------------------------
  // Application
  //
  //  is the part you'll find in ExternControl PLC
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  AppControl                        : ST_APP_CTRL;
  AppState                          : ST_APP_STATE;

  //-----------------------------------------------------------------------------------------------
  // Process instances
  //  - processes are similar but also different, hence working with inheritance of fb_Instance
  //  - change/check here if you need a process procedure that matches your use case
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  // RECTANGLE_TRACK example processes:
  //   CONTINUOUS_WPC_CLEAN,       // (1 to 1) - clean WPC with slower speed
  //   DISTRIBUTOR_INFEED,         // (1 to m) - incomming ticket data ST_PROCESS_DATA.wTarget sets target for mover
  //   PROCESS_INFEED,             // (m to 1) - place workpiece
  //   CONTINUOUS_CLEAN,           // (1 to 1) - clean workpiece
  //   CONTINUOUS_SCAN,            // (1 to 1) - scan  workpiece
  //   CONTINUOUS_CAMERA,          // (1 to 1) - take a picture
  //   DISTRIBUTOR_ASSEMBLY_01,    // (1 to m) - distributor to next
  //   PROCESS_ASSEMBLY_01,        // (m to 1) - standstill process, writes ticket to next distributor
  //   DISTRIBUTOR_ASSEMBLY_02,    // (1 to m) - distributor to next
  //   PROCESS_ASSEMBLY_02,        // (m to 1) - standstill process, writes ticket to next distributor
  //   DISTRIBUTOR_ASSEMBLY_TEST,  // (1 to m) - distributor to next
  //   PROCESS_ASSEMBLY_TEST,      // (m to 1) - standstill process, writes ticket to next distributor
  //   DISTRIBUTOR_CAMERA,         // (1 to 1) - change dyn constraint of mover on the fly
  //   CONTINUOUS_ASSEMBLY_CAMERA, // (1 to 1) - move through camera inspection
  //   DISTRIBUTOR_OUTFEED,        // (1 to m) - distributor to next
  //   PROCESS_OUTFEED,            // (m to 1) - unload workpiece
  //   DISTRIBUTOR_WPC_CLEAN,      // (1 to 1) - to next
  // RECTANGLE_TRACK example processes.
  //-----------------------------------------------------------------------------------------------
  InstanceWpcClean                  : fb_DistributorByQueue;

  InstanceDistributorInfeed         : fb_DistributorByTicket;
  InstanceInfeed                    : fb_ProcessByTicket;

  InstanceCleaner                   : fb_DistributorByQueue;
  InstanceScanner                   : fb_DistributorByQueue;
  InstanceCamera                    : fb_DistributorByQueue;

  InstanceDistributorAssembly_01    : fb_DistributorByTicket;
  InstanceAssembly_01               : fb_ProcessByTicket;

  InstanceDistributorAssembly_02    : fb_DistributorByTicket;
  InstanceAssembly_02               : fb_ProcessByTicket;

  InstanceDistributorAssemblyTest   : fb_DistributorByTicket;
  InstanceAssemblyTest              : fb_ProcessByTicket;

  InstanceAssemblyCameraInfeed      : fb_DistributorByQueue;
  InstanceAssemblyCameraOutfeed     : fb_DistributorByQueue;

  InstanceDistributorOutfeed        : fb_DistributorByTicket;
  InstanceOutfeed                   : fb_ProcessByTicket;

  InstanceDistributorWpcClean       : fb_DistributorByQueue;
  //-----------------------------------------------------------------------------------------------
  // fb_Instance control and state
  //  - structs are used to command Instances during production 
  //-----------------------------------------------------------------------------------------------
  InstanceCtrl                      : ARRAY[1..MAX_PROCESS] OF ST_INSTANCE_CTRL;
  InstanceState                     : ARRAY[1..MAX_PROCESS] OF ST_INSTANCE_STATE;


  //-----------------------------------------------------------------------------------------------
  // Linked List instances
  //-----------------------------------------------------------------------------------------------
  ProcessList                       : ARRAY[1..MAX_PROCESS] OF fb_Process_LinkedList; // information transfer between processes
  ItfProcessList                    : ARRAY[1..MAX_PROCESS] OF I_Process_LinkedList;  // use this interface in your function blocks


  //-----------------------------------------------------------------------------------------------
  // Collector instances
  //
  //  - layer for grouping parallel XtsStations for process handshakes
  //-----------------------------------------------------------------------------------------------
  //  - fb_ProcessCollector:
  //    - uses .ProcessCtrl and .ProcessState for handshakes with application
  //
  //    - .ActivateStation is evaluated after enabling infeed in state 
  //      E_PROCESS_STATE.PROCESS_DISABLE:/E_PROGRESS.PROGRESS_BUSY:
  //      
  //    - ST_PROCESS_STATE:
  //      - contains 3 enumerations for you to check
  //      - State           : E_PROCESS_STATE;
  //        - main state for handshakes
  //
  //      - Result          : E_PROGRESS;
  //        - substate for checks during handshake; 
  //          PROGRESS_BUSY --> handshakes are accepted (see fb_ProcessCollecotr.Cycle())
  //
  //      - Check           : E_PROCESS_CHECK;
  //        - cyclic pointer check: use this on startup of your application
  //
  //    - inherits fb_StationCollector
  //-----------------------------------------------------------------------------------------------
  ProcessCollector      : ARRAY[1..MAX_PROCESS] OF fb_ProcessCollector;       // grouping of XtsStations
  ItfProcessCollector   : ARRAY[1..MAX_PROCESS] OF I_ProcessCollector;        // interface for use in your function blocks like BufferInfeed etc.
  // config of processes
  ProcessParameter      : ARRAY[1..MAX_PROCESS] OF ST_PROCESS_PARAMETER;      // equivalent ST_STATION_PARAMETER, just for processes
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  // cyclic linked lists
  //
  //  - fb_LinkedListCtrl
  //    - is controlled via Ctrl/State pair
  //    - provides I_Process_LinkedList for use in conected class
  //-----------------------------------------------------------------------------------------------
  TicketControl         : fb_Process_LinkedListCtrl;
  TicketList            : fb_Process_LinkedList;
  TicketListControl     : ST_LIST_CTRL;
  TicketListState       : ST_LIST_STATE;
  TicketListDataInput   : ST_LIST_NODE_DATA;   // datafield for you to write(add) your data
  TicketListDataOutput  : ST_LIST_NODE_DATA;   // datafield for you to read (get) your data
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
  // Distribution of LinkedList ticket
  //
  //  - fb_ProcessConductor extends fb_Instance
  //    - is controlled via instance Ctrl/State pair
  //    - consumes I_Process_LinkedList for moving 
  //      the ticket from the cyclic list into the process list of ST_PROCESS_DATA.nProcessId
  //-----------------------------------------------------------------------------------------------
  ProcessConductor      : fb_ProcessConductor;
  ConductorCtrl         : ST_INSTANCE_CTRL;
  ConductorState        : ST_INSTANCE_STATE;
  //-----------------------------------------------------------------------------------------------
  //-----------------------------------------------------------------------------------------------
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>