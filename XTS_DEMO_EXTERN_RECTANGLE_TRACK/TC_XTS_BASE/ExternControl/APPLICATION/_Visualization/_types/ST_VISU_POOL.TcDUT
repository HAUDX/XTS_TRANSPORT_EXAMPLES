TYPE ST_VISU_POOL :
STRUCT
  sStationText            : STRING(30);
  stXpuStrings            : ST_XPU_STRINGS;

  eTransportState         : E_XTS_TRANSPORT_STATE;
  eTransportResult        : E_PROGRESS;

  eXpuState               : E_XPU_STATE;
