GVL_XTS.StationStartIndex                                         := 142;
GVL_XTS.StationStart.rPosWait                                     :=    5000.0; // for every TRANSPORT_START this physical position may differ from the rPosWait of StationStartIndex station

GVL_XTS.StationStart.rGap                                         :=     110.0;
GVL_XTS.StationStart.rVelo                                        :=   1_250.0;
GVL_XTS.StationStart.rAccDec                                      :=  12_500.0;
GVL_XTS.StationStart.rJerk                                        := 100_000.0;

