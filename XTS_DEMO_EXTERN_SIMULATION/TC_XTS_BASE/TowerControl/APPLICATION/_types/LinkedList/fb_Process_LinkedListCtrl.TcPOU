      <Declaration><![CDATA[PROPERTY ItfList : I_Process_LinkedList]]></Declaration>
      <Set Name="Set" Id="{8900144d-d8ef-4140-a515-6e92d5758fc0}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
