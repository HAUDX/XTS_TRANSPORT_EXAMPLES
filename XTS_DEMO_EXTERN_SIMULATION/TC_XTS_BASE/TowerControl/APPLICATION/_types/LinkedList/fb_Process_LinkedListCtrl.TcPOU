ListAddTail                     := _eState;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ListDelHead" Id="{14a8ffdf-5a16-44a6-bf1a-ff604fe21bc6}">
      <Declaration><![CDATA[METHOD ListDelHead  : e_progress
