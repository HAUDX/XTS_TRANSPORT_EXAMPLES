      <Get Name="Get" Id="{c4a1c3cd-4647-4e44-9e4f-05d0c73157ec}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[MessageLevel := _MessageLevel;
]]></ST>
        </Implementation>
      </Get>
