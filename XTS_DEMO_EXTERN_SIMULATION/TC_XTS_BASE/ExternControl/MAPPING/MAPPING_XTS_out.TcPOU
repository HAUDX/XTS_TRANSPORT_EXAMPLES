<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAPPING_XTS_out" Id="{c77b863a-5ad6-42f4-9e7b-dacbb22fccc7}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAPPING_XTS_out
VAR
  sMapping              : STRING;
  bFirstCycle           : BOOL := TRUE;

  YardState             : U_YARD_STATE;
  InstanceState         : U_INSTANCE_STATE;
  TicketListOutput      : U_TICKET_LIST_DATA_OUTPUT;
  TicketListState       : U_TICKET_LIST_STATE;

  TransportControl      : U_XTS_TRANSPORT_CTRL;
  StationControl        : U_XTS_STATION_CTRL;


  szTransportCtrl       : ARRAY[1..2] OF UDINT;
  szStationControl      : ARRAY[1..2] OF UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF (bFirstCycle)
THEN
  bFirstCycle             := FALSE;

  szTransportCtrl[1]      := SIZEOF(TransportControl);
  szTransportCtrl[2]      := SIZEOF(GVL_XTS.XtsTransportCtrl);

  szStationControl[1]     := SIZEOF(StationControl);
  szStationControl[2]     := SIZEOF(GVL_XTS.StationCtrl);
END_IF
//---------------------------------------------------------------------
IF (SIZEOF(TransportControl) <> SIZEOF(GVL_XTS.XtsTransportCtrl))
THEN
  sMapping  := 'TransportControl sizes DO NOT match';
  RETURN;
END_IF
//---------------------------------------------------------------------
IF (SIZEOF(StationControl) <> SIZEOF(GVL_XTS.StationCtrl))
THEN
  sMapping  := 'StationControl sizes DO NOT match';
  RETURN;
END_IF
//---------------------------------------------------------------------
IF (SIZEOF(YardState) <> SIZEOF(GVL_APPLICATION.YardState))
THEN
  sMapping  := 'YardState sizes DO NOT match';
  RETURN;
END_IF
//---------------------------------------------------------------------
IF (SIZEOF(InstanceState) <> SIZEOF(GVL_APPLICATION.InstanceState))
THEN
  sMapping  := 'InstanceState sizes DO NOT match';
  RETURN;
END_IF
//---------------------------------------------------------------------
sMapping    := 'MAPPING_XTS_OUTPUT ACTIVE';
//-----------------------------------------------------------------------------------------------------
//       destination,           source,                             size
//-----------------------------------------------------------------------------------------------------
  memcpy(ADR(TransportControl), ADR(GVL_XTS.XtsTransportCtrl),      SIZEOF(TransportControl));
  memcpy(ADR(StationControl),   ADR(GVL_XTS.StationCtrl),           SIZEOF(StationControl));
//-----------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------
//       destination,           source,                                     size
//-----------------------------------------------------------------------------------------------------
  memcpy(ADR(YardState),        ADR(GVL_APPLICATION.YardState),             SIZEOF(YardState));
  memcpy(ADR(InstanceState),    ADR(GVL_APPLICATION.InstanceState),         SIZEOF(InstanceState));
  memcpy(ADR(TicketListState),  ADR(GVL_APPLICATION.TicketListState),       SIZEOF(TicketListState));
  memcpy(ADR(TicketListOutput), ADR(GVL_APPLICATION.TicketListDataOutput),  SIZEOF(TicketListOutput));
//-----------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------]]></ST>
    </Implementation>
