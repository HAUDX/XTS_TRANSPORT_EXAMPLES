      GVL_APPLICATION.Simulation[nProcess].CheckRangeLow := 4500.0;
      GVL_APPLICATION.Simulation[nProcess].CheckRangeHigh:= 5600.0;


    eInit                                                 := E_PROGRESS.PROGRESS_BUSY;

  E_PROGRESS.PROGRESS_BUSY:
    GVL_MSG_XTS.TransportMessageCtrl.Cmd                  := E_MESSAGE_CTRL.MSG_CTRL_INIT;
    GVL_MSG_XTS.MetricsMessageCtrl.Cmd                    := E_MESSAGE_CTRL.MSG_CTRL_INIT;
    eInit                                                 := E_PROGRESS.PROGRESS_PREPARE;

  E_PROGRESS.PROGRESS_PREPARE:
    eInit                                                 := E_PROGRESS.PROGRESS_STARTUP;

  E_PROGRESS.PROGRESS_STARTUP:
    eInit                                                 := E_PROGRESS.PROGRESS_DONE;
    FOR nProcess := 1 TO MAX_PROCESS
    DO
      IF (GVL_APPLICATION.Simulation[nProcess].StationCount > 0)
      THEN
        GVL_APPLICATION.Simulation[nProcess].EnableProcess := TO_DWORD(EXPT(2,GVL_APPLICATION.Simulation[nProcess].StationCount))-1;
        GVL_APPLICATION.Simulation[nProcess].MoverEnter    := TRUE;
        GVL_APPLICATION.Simulation[nProcess].MoverOut      := TRUE;

      END_IF
    END_FOR
END_CASE
]]></ST>
