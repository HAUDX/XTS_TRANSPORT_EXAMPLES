<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN_APP" Id="{aed82ec5-7c0f-4ed8-9d95-00008ab7747f}" SpecialFunc="None">
    <Declaration><![CDATA[//---------------------------------------------------------------------------------------------------------------
//
//  HAUD 2026.10.25
//
//  - ExternControl
//
//    - this is the main switchboard
//
//    - Transport abstractions are called here:
//    --------------------------------------------
//    - top level transport abstractions
//      - Instances contain the required transport logic
//      - Instances control their assigned ProcessCollector
//      - Instances are controlled in timer based application
//
//    - mid level transport abstractions
//      - StationCollectors and by extension ProcessCollectors
//      - Collectors are for gathering states and routing commands to ST_STATION_CTRL/STATE
//      - Collectors are configured during startup
//
//---------------------------------------------------------------------------------------------------------------
PROGRAM MAIN_APP
VAR
  eInitXtsTransport   AT %I*    : E_PROGRESS;   // initialization from XtsTransport PLC
  eInit               AT %Q*    : E_PROGRESS;   // local startup transmitted to TowerControl

  idx                           : UINT;
  nProcess                      : E_INSTANCE;
  {attribute 'displaymode':='bin'}
  TargetMask                    : ARRAY[1..MAX_PROCESS] OF ARRAY[1..SIZEOF(T_PROCESS)*8] OF BYTE;

  // message pipeline(s) handling
  eMtrState,
  eMsgState                     : E_MESSAGE_STATE;
  eMtrProgress,
  eMsgProgress                  : E_PROGRESS;
  stMsg                         : ST_Message;
  //-------------------------------------------------------------------------------------------------------------
  tIdleWriteMotion              : TIME := T#5S;
  tIdleWriteApplication         : TIME := T#5S;
  tIdleWriteMetric              : TIME := T#5S;
  tonIdleWriteMotion            : Tc2_Standard.TON;
  tonIdleWriteApplication       : Tc2_Standard.TON;
  tonIdleWriteMetric            : Tc2_Standard.TON;
  //-------------------------------------------------------------------------------------------------------------
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//#################################################################################################################
// Local time; used for timestamps
//#################################################################################################################
GVL_MSG_XTS.fbLocalTime();
GVL_MSG_XTS.sLocalTime                                            := GVL_MSG_XTS.fbLocalTime.LocalTimeString;
GVL_MSG_XTS.dtLocalTime                                           := GVL_MSG_XTS.fbLocalTime.LocalTime;
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
// check for Initialisation from XtsTransport first
//  - wait for XtsTransport to be fully started up
//-----------------------------------------------------------------------------------------------------------------
IF NOT (eInitXtsTransport = E_PROGRESS.PROGRESS_DONE) THEN eInit  := E_PROGRESS.PROGRESS_INVALID; RETURN; END_IF
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
// initialization for:
//  - configuring processes
//  - starting up of processes
//  - cross checking with the rest of your application
//-----------------------------------------------------------------------------------------------------------------
CASE eInit
OF
  E_PROGRESS.PROGRESS_INVALID:
    eInit                                         := E_PROGRESS.PROGRESS_INIT;

  E_PROGRESS.PROGRESS_INIT:
    // init processes
    eInit                                         := E_PROGRESS.PROGRESS_BUSY;
    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_INFEED].ProcessId            := DISTRIBUTOR_INFEED;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_INFEED].StationFirst         :=   1;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_INFEED].StationLast          :=   1;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorInfeed.ProcessId                       := DISTRIBUTOR_INFEED;
    GVL_APPLICATION.InstanceDistributorInfeed.ProcessTarget                   := PROCESS_INFEED;
    GVL_APPLICATION.InstanceDistributorInfeed.CheckPositionStart              :=  1500.0;
    GVL_APPLICATION.InstanceDistributorInfeed.CheckPositionEnd                :=  2000.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorInfeed.CollectorInterface              :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceDistributorInfeed.ProcessLinkedLists              :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceDistributorInfeed.InstanceCtrl                    REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceDistributorInfeed.InstanceState                   REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[PROCESS_INFEED].ProcessId                := PROCESS_INFEED;
    GVL_APPLICATION.ProcessCollector[PROCESS_INFEED].StationFirst             :=    2;
    GVL_APPLICATION.ProcessCollector[PROCESS_INFEED].StationLast              :=    2;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceInfeed.ProcessId                                  := PROCESS_INFEED;
    GVL_APPLICATION.InstanceInfeed.ProcessTarget                              := DISTRIBUTOR_FREE;
    GVL_APPLICATION.InstanceInfeed.CheckPositionStart                         :=  1750.0;
    GVL_APPLICATION.InstanceInfeed.CheckPositionEnd                           :=  2250.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceInfeed.CollectorInterface                         :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceInfeed.ProcessLinkedLists                         :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceInfeed.InstanceCtrl                               REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceInfeed.InstanceState                              REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_FREE].ProcessId              := DISTRIBUTOR_FREE;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_FREE].StationFirst           :=    5;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_FREE].StationLast            :=    5;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorFree.ProcessId                         := DISTRIBUTOR_FREE;
    GVL_APPLICATION.InstanceDistributorFree.ProcessTarget                     := PROCESS_FREE;
    GVL_APPLICATION.InstanceDistributorFree.CheckPositionStart                := 2450.0;
    GVL_APPLICATION.InstanceDistributorFree.CheckPositionEnd                  := 2600.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorFree.CollectorInterface                :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceDistributorFree.ProcessLinkedLists                :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceDistributorFree.InstanceCtrl                      REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceDistributorFree.InstanceState                     REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[PROCESS_FREE].ProcessId                  := PROCESS_FREE;
    GVL_APPLICATION.ProcessCollector[PROCESS_FREE].StationFirst               :=    6;
    GVL_APPLICATION.ProcessCollector[PROCESS_FREE].StationLast                :=    6;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceFree.ProcessId                                    := PROCESS_FREE;
    GVL_APPLICATION.InstanceFree.ProcessTarget                                := DISTRIBUTOR_HOUSING;
    GVL_APPLICATION.InstanceFree.CheckPositionStart                           := 100.0;
    GVL_APPLICATION.InstanceFree.CheckPositionEnd                             := 200.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceFree.CollectorInterface                           :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceFree.ProcessLinkedLists                           :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceFree.InstanceCtrl                                 REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceFree.InstanceState                                REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_HOUSING].ProcessId           := DISTRIBUTOR_HOUSING;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_HOUSING].StationFirst        :=    7;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_HOUSING].StationLast         :=    7;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorHousing.ProcessId                      := DISTRIBUTOR_HOUSING;
    GVL_APPLICATION.InstanceDistributorHousing.ProcessTarget                  := PROCESS_HOUSING;
    GVL_APPLICATION.InstanceDistributorHousing.CheckPositionStart             := 200.0;
    GVL_APPLICATION.InstanceDistributorHousing.CheckPositionEnd               := 300.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorHousing.CollectorInterface             :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceDistributorHousing.ProcessLinkedLists             :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceDistributorHousing.InstanceCtrl                   REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceDistributorHousing.InstanceState                  REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[PROCESS_HOUSING].ProcessId               := PROCESS_HOUSING;
    GVL_APPLICATION.ProcessCollector[PROCESS_HOUSING].StationFirst            :=    8;
    GVL_APPLICATION.ProcessCollector[PROCESS_HOUSING].StationLast             :=    8;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceHousing.ProcessId                                 := PROCESS_HOUSING;
    GVL_APPLICATION.InstanceHousing.ProcessTarget                             := DISTRIBUTOR_ROCKER;
    GVL_APPLICATION.InstanceHousing.CheckPositionStart                        := 300.0;
    GVL_APPLICATION.InstanceHousing.CheckPositionEnd                          := 350.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceHousing.CollectorInterface                        :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceHousing.ProcessLinkedLists                        :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceHousing.InstanceCtrl                              REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceHousing.InstanceState                             REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    TargetMask[DISTRIBUTOR_ROCKER][1]                                        := 2#_0001_1111;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_ROCKER].ProcessId           := DISTRIBUTOR_ROCKER;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_ROCKER].StationFirst        :=    9;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_ROCKER].StationLast         :=    9;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_ROCKER].TargetMask          := TargetMask[DISTRIBUTOR_ROCKER];
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorRocker.ProcessId                      := DISTRIBUTOR_ROCKER;
    GVL_APPLICATION.InstanceDistributorRocker.ProcessTarget                  := PROCESS_ROCKER;
    GVL_APPLICATION.InstanceDistributorRocker.CheckPositionStart             := 350.0;
    GVL_APPLICATION.InstanceDistributorRocker.CheckPositionEnd               := 550.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorRocker.CollectorInterface             :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceDistributorRocker.ProcessLinkedLists             :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceDistributorRocker.InstanceCtrl                   REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceDistributorRocker.InstanceState                  REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[PROCESS_ROCKER].ProcessId               := PROCESS_ROCKER;
    GVL_APPLICATION.ProcessCollector[PROCESS_ROCKER].StationFirst            :=    10;
    GVL_APPLICATION.ProcessCollector[PROCESS_ROCKER].StationLast             :=    11;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceRocker.ProcessId                                 := PROCESS_ROCKER;
    GVL_APPLICATION.InstanceRocker.ProcessTarget                             := DISTRIBUTOR_ASSEMBLY_CHECK;
    GVL_APPLICATION.InstanceRocker.CheckPositionStart                        := 350.0;
    GVL_APPLICATION.InstanceRocker.CheckPositionEnd                          := 1000.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceRocker.CollectorInterface                        :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceRocker.ProcessLinkedLists                        :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceRocker.InstanceCtrl                              REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceRocker.InstanceState                             REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    TargetMask[DISTRIBUTOR_ASSEMBLY_CHECK][1]                                := 2#_0001_1111;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_ASSEMBLY_CHECK].ProcessId   := DISTRIBUTOR_ASSEMBLY_CHECK;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_ASSEMBLY_CHECK].StationFirst:=    13;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_ASSEMBLY_CHECK].StationLast :=    13;
    GVL_APPLICATION.ProcessCollector[DISTRIBUTOR_ASSEMBLY_CHECK].TargetMask          := TargetMask[DISTRIBUTOR_ASSEMBLY_CHECK];
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorCheck.ProcessId                       := DISTRIBUTOR_ASSEMBLY_CHECK;
    GVL_APPLICATION.InstanceDistributorCheck.ProcessTarget                   := PROCESS_ASSEMBLY_CHECK;
    GVL_APPLICATION.InstanceDistributorCheck.CheckPositionStart              := 1400.0;
    GVL_APPLICATION.InstanceDistributorCheck.CheckPositionEnd                := 1600.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceDistributorCheck.CollectorInterface              :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceDistributorCheck.ProcessLinkedLists              :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceDistributorCheck.InstanceCtrl                    REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceDistributorCheck.InstanceState                   REF= GVL_APPLICATION.InstanceState;

    //-----------------------------------------------------------------------------
    //#############################################################################
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.ProcessCollector[PROCESS_ASSEMBLY_CHECK].ProcessId       := PROCESS_ASSEMBLY_CHECK;
    GVL_APPLICATION.ProcessCollector[PROCESS_ASSEMBLY_CHECK].StationFirst    :=    14;
    GVL_APPLICATION.ProcessCollector[PROCESS_ASSEMBLY_CHECK].StationLast     :=    14;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceCheck.ProcessId                                  := PROCESS_ASSEMBLY_CHECK;
    GVL_APPLICATION.InstanceCheck.ProcessTarget                              := DISTRIBUTOR_INFEED;
    GVL_APPLICATION.InstanceCheck.CheckPositionStart                         := 1650.0;
    GVL_APPLICATION.InstanceCheck.CheckPositionEnd                           := 2000.0;
    //-----------------------------------------------------------------------------
    GVL_APPLICATION.InstanceCheck.CollectorInterface                         :=   GVL_APPLICATION.ItfProcessCollector;
    GVL_APPLICATION.InstanceCheck.ProcessLinkedLists                         :=   GVL_APPLICATION.ItfProcessList;
    GVL_APPLICATION.InstanceCheck.InstanceCtrl                               REF= GVL_APPLICATION.InstanceCtrl;
    GVL_APPLICATION.InstanceCheck.InstanceState                              REF= GVL_APPLICATION.InstanceState;


  E_PROGRESS.PROGRESS_BUSY:
    // init the conductor
    GVL_APPLICATION.ConductorCtrl.Cmd             := E_INSTANCE_CMD.INIT;
    // init the instances
    idx                                           := 1;
    memset(ADR(GVL_APPLICATION.InstanceCtrl), 0, SIZEOF(GVL_APPLICATION.InstanceCtrl));
    eInit                                         := E_PROGRESS.PROGRESS_PREPARE;

  E_PROGRESS.PROGRESS_PREPARE:
    GVL_APPLICATION.InstanceCtrl[idx].Cmd         := E_INSTANCE_CMD.INIT;

    IF (GVL_APPLICATION.InstanceState[idx].ProcessState   = E_INSTANCE_STATE.DISABLED)
    THEN
      IF (GVL_APPLICATION.InstanceState[idx].ProcessProgress = E_PROGRESS.PROGRESS_BUSY)
      THEN
        GVL_APPLICATION.InstanceCtrl[idx].Cmd     := E_INSTANCE_CMD.DISABLE;
        eInit                                     := E_PROGRESS.PROGRESS_STARTUP;
      END_IF
    END_IF


  E_PROGRESS.PROGRESS_STARTUP:
    IF NOT (idx < GVL_APPLICATION.MAX_PROCESS)
    THEN
      eInit                                       := E_PROGRESS.PROGRESS_CHECK;
    ELSE
      idx                                         := idx + 1;
      eInit                                       := E_PROGRESS.PROGRESS_PREPARE;
    END_IF

  E_PROGRESS.PROGRESS_CHECK:
    GVL_APPLICATION.ConductorCtrl.Cmd             := E_INSTANCE_CMD.ENABLE;
    eInit                                         := E_PROGRESS.PROGRESS_OCCUPIED;

  E_PROGRESS.PROGRESS_OCCUPIED:
    eInit                                         := E_PROGRESS.PROGRESS_WORKING;

  E_PROGRESS.PROGRESS_WORKING:
    eInit                                         := E_PROGRESS.PROGRESS_DONE;
END_CASE
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
// /assign dataflow
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
//  - The YardMaster
//-----------------------------------------------------------------------------------------------------------------
GVL_APPLICATION.YardMaster.Ctrl                               REF= GVL_APPLICATION.YardControl;
GVL_APPLICATION.YardMaster.State                              REF= GVL_APPLICATION.YardState;

GVL_APPLICATION.YardMaster.XtsTransportCtrl                   REF= GVL_XTS.XtsTransportCtrl;
GVL_APPLICATION.YardMaster.XtsTransportState                  REF= GVL_XTS.XtsTransportState;

GVL_APPLICATION.YardMaster.CollectorInterfaces                :=   GVL_APPLICATION.ItfProcessCollector;
GVL_APPLICATION.YardMaster.TicketList                         :=   GVL_APPLICATION.TicketList;
GVL_APPLICATION.YardMaster();
//-----------------------------------------------------------------------------------------------------------------
//  - ProcessCollectors
//-----------------------------------------------------------------------------------------------------------------
FOR nProcess := 1 TO MAX_PROCESS
DO
  GVL_APPLICATION.ItfProcessList[nProcess]                    :=   GVL_APPLICATION.ProcessList[nProcess];
  GVL_APPLICATION.ItfProcessCollector[nProcess]               :=   GVL_APPLICATION.ProcessCollector[nProcess];

  GVL_APPLICATION.ProcessCollector[nProcess].MessageLevel     :=   GVL_MSG_XTS.MessageLevelProcess[nProcess];
  GVL_APPLICATION.ProcessCollector[nProcess].MoverInfo        REF= GVL_XTS.MoverInfo;
  GVL_APPLICATION.ProcessCollector[nProcess].StationCtrl      REF= GVL_XTS.StationCtrl;
  GVL_APPLICATION.ProcessCollector[nProcess].StationState     REF= GVL_XTS.StationState;
  GVL_APPLICATION.ProcessCollector[nProcess].TargetMask       := TargetMask[nProcess];
  GVL_APPLICATION.ProcessCollector[nProcess].Cycle();
END_FOR

//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
// cyclic TicketList as inbox
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
GVL_APPLICATION.TicketControl.ItfList                         :=   GVL_APPLICATION.TicketList;
GVL_APPLICATION.TicketControl.Ctrl                            REF= GVL_APPLICATION.TicketListControl;
GVL_APPLICATION.TicketControl.State                           REF= GVL_APPLICATION.TicketListState;
GVL_APPLICATION.TicketControl.NodeDataInput                   REF= GVL_APPLICATION.TicketListDataInput;
GVL_APPLICATION.TicketControl.NodeDataOutput                  REF= GVL_APPLICATION.TicketListDataOutput;
GVL_APPLICATION.TicketControl();
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
// Conductor
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
GVL_APPLICATION.ProcessConductor.ProcessLinkedLists           :=   GVL_APPLICATION.ItfProcessList;
GVL_APPLICATION.ProcessConductor.TicketLinkedList             :=   GVL_APPLICATION.TicketList;
GVL_APPLICATION.ProcessConductor.Ctrl                         REF= GVL_APPLICATION.ConductorCtrl;
GVL_APPLICATION.ProcessConductor.State                        REF= GVL_APPLICATION.ConductorState;
GVL_APPLICATION.ProcessConductor();
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
// Instance calls
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
GVL_APPLICATION.InstanceCheck();
GVL_APPLICATION.InstanceDistributorCheck();
GVL_APPLICATION.InstanceRocker();
GVL_APPLICATION.InstanceDistributorRocker();
GVL_APPLICATION.InstanceHousing();
GVL_APPLICATION.InstanceDistributorHousing();
GVL_APPLICATION.InstanceFree();
GVL_APPLICATION.InstanceDistributorFree();
GVL_APPLICATION.InstanceInfeed();
GVL_APPLICATION.InstanceDistributorInfeed();
//-----------------------------------------------------------------------------------------------------------------
//-----------------------------------------------------------------------------------------------------------------
//#################################################################################################################
//  /logging
//    - all life is problem solving
//#################################################################################################################
GVL_MSG_XTS.TransportMessageData.Ctrl               REF= GVL_MSG_XTS.TransportMessageCtrl;
GVL_MSG_XTS.TransportMessageData.State              REF= GVL_MSG_XTS.TransportMessageState;
GVL_MSG_XTS.TransportMessageData.MessageIndex       REF= GVL_MSG_XTS.MessageTransportIndex;
GVL_MSG_XTS.TransportMessageData.ErrorIndex         REF= GVL_MSG_XTS.MessageTransportError;
GVL_MSG_XTS.TransportMessageData.DirRoot            :=   ADR(GVL_MSG_XTS.LOG_DIR);
GVL_MSG_XTS.TransportMessageData.FileRoot           :=   ADR(GVL_MSG_XTS.LOG_FILE);
GVL_MSG_XTS.TransportMessageData.MsgList            :=   ADR(GVL_MSG_XTS.TransportMessages);
GVL_MSG_XTS.TransportMessageData.LocalTime          :=   ADR(GVL_MSG_XTS.dtLocalTime);
GVL_MSG_XTS.TransportMessageData();
eMsgState                                       :=   f_GetState   (GVL_MSG_XTS.TransportMessageState.State);
eMsgProgress                                    :=   f_GetProgress(GVL_MSG_XTS.TransportMessageState.State);

CASE eMsgState
OF
  E_MESSAGE_STATE.MSG_STATE_NULL:
    CASE eMsgProgress
    OF
      E_PROGRESS.PROGRESS_INVALID,
      E_PROGRESS.PROGRESS_DONE:
        IF (GVL_MSG_XTS.MessageTransportIndex > GVL_MSG_XTS.MAX_MESSAGE/101) OR
           (GVL_MSG_XTS.MessageTransportError > 0)
        THEN
          GVL_MSG_XTS.TransportMessageCtrl.Cmd      := E_MESSAGE_CTRL.MSG_CTRL_WRITE;
        ELSE
          tonIdleWriteMotion(IN := TRUE, PT:= tIdleWriteMotion);
          IF (tonIdleWriteMotion.Q)
          THEN
            GVL_MSG_XTS.TransportMessageCtrl.Cmd    := E_MESSAGE_CTRL.MSG_CTRL_WRITE;
          END_IF
        END_IF
    END_CASE

  E_MESSAGE_STATE.MSG_STATE_WRITE:
    CASE eMsgProgress
    OF
      E_PROGRESS.PROGRESS_ERROR,
      E_PROGRESS.PROGRESS_DONE:
          tonIdleWriteMotion(IN := FALSE, PT:= tIdleWriteMotion);
        GVL_MSG_XTS.TransportMessageCtrl.Cmd        := E_MESSAGE_CTRL.MSG_CTRL_NULL;
    END_CASE

ELSE
    CASE eMsgProgress
    OF
      E_PROGRESS.PROGRESS_DONE:
          tonIdleWriteMotion(IN := FALSE, PT:= tIdleWriteMotion);
        GVL_MSG_XTS.TransportMessageCtrl.Cmd        := E_MESSAGE_CTRL.MSG_CTRL_NULL;
    END_CASE
END_CASE
//#################################################################################################################
// /application logging
//#################################################################################################################
GVL_MSG_XTS.ApplicationMessageData.Ctrl                         REF= GVL_MSG_XTS.ApplicationMessageCtrl;
GVL_MSG_XTS.ApplicationMessageData.State                        REF= GVL_MSG_XTS.ApplicationMessageState;

GVL_MSG_XTS.ApplicationMessageData.MessageIndex                 REF= GVL_MSG_XTS.MessageApplicationIndex;
GVL_MSG_XTS.ApplicationMessageData.ErrorIndex                   REF= GVL_MSG_XTS.MessageApplicationError;

GVL_MSG_XTS.ApplicationMessageData.DirRoot                      :=   ADR(GVL_MSG_XTS.LOG_DIR);
GVL_MSG_XTS.ApplicationMessageData.FileRoot                     :=   ADR(GVL_MSG_XTS.LOG_FILE_APP);
GVL_MSG_XTS.ApplicationMessageData.MsgList                      :=   ADR(GVL_MSG_XTS.ApplicationMessages);
GVL_MSG_XTS.ApplicationMessageData.LocalTime                    :=   ADR(GVL_MSG_XTS.dtLocalTime);

GVL_MSG_XTS.ApplicationMessageData();

eMsgState                                       := f_GetState   (GVL_MSG_XTS.ApplicationMessageState.State);
eMsgProgress                                    := f_GetProgress(GVL_MSG_XTS.ApplicationMessageState.State);


CASE eMsgState
OF
  E_MESSAGE_STATE.MSG_STATE_NULL:
    CASE eMsgProgress
    OF
      E_PROGRESS.PROGRESS_INVALID:
        IF (GVL_MSG_XTS.MessageApplicationIndex > GVL_MSG_XTS.MAX_MESSAGE/13) OR
           (GVL_MSG_XTS.MessageApplicationError > 0)
        THEN
          GVL_MSG_XTS.ApplicationMessageCtrl.Cmd                := E_MESSAGE_CTRL.MSG_CTRL_WRITE;
        ELSE
          tonIdleWriteApplication(IN := TRUE, PT:= tIdleWriteApplication);
          IF (tonIdleWriteApplication.Q)
          THEN
            GVL_MSG_XTS.ApplicationMessageCtrl.Cmd              := E_MESSAGE_CTRL.MSG_CTRL_WRITE;
          END_IF
        END_IF
    END_CASE

  E_MESSAGE_STATE.MSG_STATE_WRITE:
    CASE eMsgProgress
    OF
      E_PROGRESS.PROGRESS_ERROR,
      E_PROGRESS.PROGRESS_DONE:
        tonIdleWriteApplication(IN := FALSE, PT:= tIdleWriteApplication);
        GVL_MSG_XTS.ApplicationMessageCtrl.Cmd                  := E_MESSAGE_CTRL.MSG_CTRL_NULL;
    END_CASE

ELSE
    CASE eMsgProgress
    OF
      E_PROGRESS.PROGRESS_DONE:
        tonIdleWriteApplication(IN := FALSE, PT:= tIdleWriteApplication);
        GVL_MSG_XTS.ApplicationMessageCtrl.Cmd                  := E_MESSAGE_CTRL.MSG_CTRL_NULL;
    END_CASE
END_CASE
//#################################################################################################################
// logging/
//#################################################################################################################
//#################################################################################################################
//  /Transport Metrics
//#################################################################################################################
GVL_MSG_XTS.MetricsMessageData.Ctrl                             REF= GVL_MSG_XTS.MetricsMessageCtrl;
GVL_MSG_XTS.MetricsMessageData.State                            REF= GVL_MSG_XTS.MetricsMessageState;

GVL_MSG_XTS.MetricsMessageData.MessageIndex                     REF= GVL_MSG_XTS.MessageMetricsIndex;
GVL_MSG_XTS.MetricsMessageData.ErrorIndex                       REF= GVL_MSG_XTS.MessageMetricsError;

GVL_MSG_XTS.MetricsMessageData.DirRoot                          :=   ADR(GVL_MSG_XTS.LOG_DIR);
GVL_MSG_XTS.MetricsMessageData.FileRoot                         :=   ADR(GVL_MSG_XTS.LOG_FILE_METRIC);
GVL_MSG_XTS.MetricsMessageData.MsgList                          :=   ADR(GVL_MSG_XTS.MetricsMessages);
GVL_MSG_XTS.MetricsMessageData.LocalTime                        :=   ADR(GVL_MSG_XTS.dtLocalTime);

GVL_MSG_XTS.MetricsMessageData();

eMtrState                                   := f_GetState   (GVL_MSG_XTS.MetricsMessageState.State);
eMtrProgress                                := f_GetProgress(GVL_MSG_XTS.MetricsMessageState.State);

CASE eMtrState
OF
  E_MESSAGE_STATE.MSG_STATE_NULL:
    CASE eMtrProgress
    OF
      E_PROGRESS.PROGRESS_INVALID:
        IF (GVL_MSG_XTS.MessageMetricsIndex > GVL_MSG_XTS.MAX_MESSAGE/5) OR
           (GVL_MSG_XTS.MessageMetricsError > 0)
        THEN
          GVL_MSG_XTS.MetricsMessageCtrl.Cmd                    := E_MESSAGE_CTRL.MSG_CTRL_WRITE;
        ELSE
          tonIdleWriteMetric(IN := TRUE, PT:= tIdleWriteMetric);
          IF (tonIdleWriteMetric.Q)
          THEN
            GVL_MSG_XTS.MetricsMessageCtrl.Cmd                  := E_MESSAGE_CTRL.MSG_CTRL_WRITE;
          END_IF
        END_IF
    END_CASE

  E_MESSAGE_STATE.MSG_STATE_WRITE:
    CASE eMtrProgress
    OF
      E_PROGRESS.PROGRESS_ERROR,
      E_PROGRESS.PROGRESS_DONE:
        tonIdleWriteMetric(IN := FALSE, PT:= tIdleWriteMetric);
        GVL_MSG_XTS.MetricsMessageCtrl.Cmd                      := E_MESSAGE_CTRL.MSG_CTRL_NULL;
    END_CASE
ELSE
    CASE eMtrProgress
    OF
      E_PROGRESS.PROGRESS_DONE:
        tonIdleWriteMetric(IN := FALSE, PT:= tIdleWriteMetric);
        GVL_MSG_XTS.MetricsMessageCtrl.Cmd                      := E_MESSAGE_CTRL.MSG_CTRL_NULL;
    END_CASE
END_CASE
//#################################################################################################################
//  Transport Metrics/
//#################################################################################################################
//#################################################################################################################
//#################################################################################################################
]]></ST>
    </Implementation>
    <Action Name="Init" Id="{69838e0d-19cf-48fe-8b42-ee1af1eba2b6}">
      <Implementation>
        <ST><![CDATA[CASE eInit
OF
  E_PROGRESS.PROGRESS_INVALID:          // startup procedure for your application
    eInit                               := E_PROGRESS.PROGRESS_INIT;

  E_PROGRESS.PROGRESS_INIT:
      nProcess                                        := 1;
      tProcess[nProcess]                              := T#750MS;

      GVL_APPLICATION.Simulation[nProcess].HandshakeRoute:= E_PROCESS_HANDSHAKE.E_SHAKE_DOUBLE;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 1;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 16;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 20;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 35;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      GVL_APPLICATION.Simulation[nProcess].CheckRangeLow :=   10.0;
      GVL_APPLICATION.Simulation[nProcess].CheckRangeHigh:= 1600.0;

      //---------------------------------------------------------

      // 2

      //---------------------------------------------------------
      nProcess                                        := 3;
      tProcess[nProcess]                              := T#2400MS;

      GVL_APPLICATION.Simulation[nProcess].HandshakeRoute:= E_PROCESS_HANDSHAKE.E_SHAKE_DOUBLE;

      GVL_APPLICATION.Simulation[nProcess].StationFirst  := 20;
      GVL_APPLICATION.Simulation[nProcess].StationLast   := 35;

      GVL_APPLICATION.Simulation[nProcess].TargetFirst   := 37;
      GVL_APPLICATION.Simulation[nProcess].TargetLast    := 37;
      GVL_APPLICATION.Simulation[nProcess].TargetMask    := 2#0001; // mask for target station

      GVL_APPLICATION.Simulation[nProcess].CheckRangeLow := 9000.0;
      GVL_APPLICATION.Simulation[nProcess].CheckRangeHigh:= 12100.0;

      //---------------------------------------------------------
      nProcess                                        := 4;
