  <DUT Name="U_MOVER_CTRL" Id="{110aada3-7399-4813-8c4a-ce1e14c6d34f}">
    <Declaration><![CDATA[TYPE U_MOVER_CTRL :
UNION
  stCtrl              : ARRAY[1..MAX_MOVER] OF ST_MOVER_CTRL;

  byCtrl    AT %Q*    : ARRAY[1..MAX_MOVER] OF
                        ARRAY[1..SIZEOF(ST_MOVER_CTRL)] OF BYTE;
END_UNION
END_TYPE
]]></Declaration>
  </DUT>
